#!/bin/bash -l
#PBS -N ace2_batch_probe
#PBS -A lighthouse-uchicago
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l filesystems=home:eagle
#PBS -l walltime=00:50:00
#PBS -r n
#PBS -j oe
# ============================================================================
# DOES THE PAPER'S GLOBAL BATCH 16 FIT ON ONE POLARIS NODE?
#
# THE QUESTION. Our production shape is global batch 8, forced by a measured
# ceiling of "largest local batch is 2; local 3 OOMs at 38.20 GiB" (jobs
# 7586496 / 7586506 / 7586526, 2026-09-02). ai2's own ACE2-ERA5 recipe
# -- `ace_exp/configs/baselines/era5/ace-train-config.yaml`, vendored in this
# repo and unopened until 2026-09-10 -- runs **global batch 16** with
# **`use_gradient_accumulation: true`**, while `config_polaris.yaml:110` has it
# **false**. The entire ceiling was measured at the wrong setting.
#
# Why the setting can move the ceiling: with accumulation on, fme detaches the
# autoregressive state between steps and calls backward on each step
# immediately (`core/optimization.py`), so step-1 activations are freed before
# step-2's forward. At `n_forward_steps: 2` that is roughly half the activation
# window. ⚠ It is NOT a free memory win -- it is truncated BPTT, i.e. a
# different gradient, and therefore a science deviation. But it is a deviation
# TOWARD the published baseline, which is the point.
#
# WHAT IT DECIDES. If local 4 fits, we get the paper's global batch 16 AND its
# lr 1e-4 at no cost, roughly halving optimizer steps per epoch, and the whole
# "our LR 3e-4 was swept at a batch the paper never used" problem evaporates.
# If it does not, global batch 8 stands on measured ground for the first time.
#
# ARMS (sequential, one allocation). Arm 4 is the control that makes the
# comparison apples-to-apples rather than trusting a 2026-09-02 measurement:
#   1  local 2, accumulation ON    -- does accumulation change memory at a known-good batch?
#   2  local 3, accumulation ON    -- the arm that OOM'd with accumulation OFF
#   3  local 4, accumulation ON    -- the paper's global batch 16 on one node
#   4  local 3, accumulation OFF   -- reproduce the known OOM, same session, same node
# An OOM is a RESULT here, not a failure: the job records it and continues.
#
# PASS = ACE2_BATCH_PROBE_OK + one row per arm. Per CLAUDE.md #14 the token is
# the signal, not rc.
# ============================================================================

cd "${PBS_O_WORKDIR}" || exit 2
ACE2_DIR="$(cd "${PBS_O_WORKDIR}" && pwd)"
[ -d "${ACE2_DIR}/ace_exp" ] || ACE2_DIR="${ACE2_DIR}/ACE2_retrain"
if [ ! -d "${ACE2_DIR}/ace_exp" ]; then
    echo "ERROR ACE2_TREE_NOT_FOUND from PBS_O_WORKDIR=${PBS_O_WORKDIR}"; exit 2
fi
REPO="$(cd "${ACE2_DIR}/.." && pwd)"
SHIM="${ACE2_DIR}/polaris/polaris_rank_env.sh"
CONFIG="${ACE2_DIR}/config_polaris.yaml"

# ---- environment: copied from polaris_ace2_train.pbs, deliberately ----------
# shellcheck disable=SC1091
source "${REPO}/polaris_env.sh" || exit 2
# shellcheck disable=SC1091
source "${ACE2_DIR}/polaris/polaris_ace2_env.sh" || exit 2
[ -x "${ACE2_VENV}/bin/python" ] || { echo "ERROR ACE2_VENV_MISSING ${ACE2_VENV}"; exit 3; }
# shellcheck disable=SC1091
source "${ACE2_VENV}/bin/activate"
export PYTHONNOUSERSITE=1
PY="${ACE2_VENV}/bin/python"
for f in "${SHIM}" "${CONFIG}" "${ACE2_DIR}/ace2_telemetry.py"; do
    [ -f "${f}" ] || { echo "ERROR MISSING ${f}"; exit 3; }
done
VENV_FME="$("${PY}" -c 'import fme,os;print(os.path.realpath(os.path.dirname(fme.__file__)))' 2>/dev/null)"
THIS_FME="$(cd "${ACE2_DIR}/ace_exp/fme" && pwd -P)"
[ "${VENV_FME}" = "${THIS_FME}" ] || {
    echo "ERROR ACE2_WRONG_CHECKOUT venv=${VENV_FME:-<import failed>} job=${THIS_FME}"; exit 3; }

JOBID="${PBS_JOBID%%.*}"
OUT="${MEMBER_ROOT}/runs/ace2_batch_probe/${JOBID}"
mkdir -p "${OUT}" || exit 2
export TMPDIR=/tmp
export OMP_NUM_THREADS="${OMP_THREADS:-2}"
export NCCL_ALGO="${NCCL_ALGO-Ring}"
export NCCL_DEBUG=WARN
export MASTER_ADDR; MASTER_ADDR="$(head -n1 "${PBS_NODEFILE}")"
export ACE2_EPOCH_TELEMETRY=1
export ACE2_EPOCH_TELEMETRY_EPOCHS=0
export ACE2_MEM_LOG=1
export ACE2_N_LOADERS=4
# The metric echo is noise for a memory probe and adds 837 log lines per arm.
export ACE2_LOG_ALL_METRICS=0
GPUS_PER_NODE=4
STEPS="${STEPS:-20}"

echo "=== ace2_batch_probe: $(date -Iseconds) ==="
echo "jobid=${JOBID}  steps/arm=${STEPS}"
nvidia-smi -L
echo "reference (ai2): $("${PY}" -c "
import yaml;c=yaml.safe_load(open('${ACE2_DIR}/ace_exp/configs/baselines/era5/ace-train-config.yaml'))
o=c['optimization'];print('batch_size=%s use_gradient_accumulation=%s amp=%s lr=%s max_epochs=%s'%(
 c['train_loader']['batch_size'],o['use_gradient_accumulation'],
 o['enable_automatic_mixed_precision'],o['lr'],c['max_epochs']))")"
echo "ours     : $("${PY}" -c "
import yaml;c=yaml.safe_load(open('${CONFIG}'))
o=c['optimization'];print('batch_size=%s use_gradient_accumulation=%s amp=%s lr=%s max_epochs=%s'%(
 c['train_loader']['batch_size'],o['use_gradient_accumulation'],
 o['enable_automatic_mixed_precision'],o['lr'],c['max_epochs']))")"
echo

run_arm() {  # run_arm <idx> <local_batch> <grad_accum true|false>
    local idx="$1" lb="$2" ga="$3"
    local gb=$(( lb * GPUS_PER_NODE ))
    local tag="arm${idx}_lb${lb}_ga${ga}"
    local log="${OUT}/${tag}.log"
    local exp="${OUT}/${tag}"
    mkdir -p "${exp}"
    export ACE2_RUN_NAME="${tag}"
    export ACE2_EPOCH_TELEMETRY_CSV="${OUT}/${tag}_telemetry.csv"
    # Distinct port per arm: a previous arm's TCPStore can linger a few seconds.
    export MASTER_PORT=$(( 21000 + JOBID % 10000 + idx * 7 ))
    echo "--- ${tag}: local_batch=${lb} global_batch=${gb} use_gradient_accumulation=${ga} ---"
    mpiexec -n "${GPUS_PER_NODE}" --ppn "${GPUS_PER_NODE}" --hostfile "${PBS_NODEFILE}" \
        --cpu-bind depth -d 8 --label --line-buffer \
        bash "${SHIM}" "${PY}" "${ACE2_DIR}/ace2_telemetry.py" "${CONFIG}" \
        --override \
          "experiment_dir=${exp}" \
          "max_epochs=1" "segment_epochs=1" \
          "save_checkpoint=false" "checkpoint_save_epochs=null" \
          "inference=null" \
          "train_loader.batch_size=${gb}" \
          "train_loader.num_data_workers=4" \
          "train_loader.sample_with_replacement=$(( STEPS * gb ))" \
          "train_evaluation_samples=${gb}" \
          "validation_loader.batch_size=${GPUS_PER_NODE}" \
          "validation_loader.num_data_workers=4" \
          "validation_loader.dataset.subset.stop_time=1996-01-06" \
          "log_train_every_n_batches=10" \
          "optimization.use_gradient_accumulation=${ga}" \
        > "${log}" 2>&1
    local rc=$?
    local peak oom step
    peak=$(sed -n 's/.*alloc_peak_gib=\([0-9.]*\).*/\1/p' "${log}" | tail -1)
    # `grep -c ... || echo 0` emits TWO lines when grep matches nothing (its own
    # "0" plus the fallback), and `[ "0\n0" -gt 0 ]` then errors with "integer
    # expression expected". Observed in job 7608867; harmless there because the
    # rc branch caught it, but it would misreport a real OOM. Count without the
    # fallback and normalise.
    oom=$(grep -ci "out of memory" "${log}" 2>/dev/null | head -1)
    oom="${oom:-0}"
    step=$("${PY}" - "${ACE2_EPOCH_TELEMETRY_CSV}" <<'PYEOF' 2>/dev/null
import csv,sys,os
p=sys.argv[1]
if os.path.exists(p):
    rows=list(csv.DictReader(open(p)))
    if rows:
        for k in ("step_med_ms","step_median_ms","step_med"):
            if k in rows[-1]: print(rows[-1][k]); break
PYEOF
)
    printf '%s,%s,%s,%s,%s,%s,%s\n' "${tag}" "${lb}" "${gb}" "${ga}" "${rc}" \
        "${peak:-NA}" "${step:-NA}" >> "${OUT}/results.csv"
    if [ "${oom}" -gt 0 ]; then
        echo "  RESULT ${tag}: OOM (rc=${rc}) peak=${peak:-NA} GiB"
    elif [ ${rc} -eq 0 ]; then
        echo "  RESULT ${tag}: FITS  peak=${peak:-NA} GiB  step_med=${step:-NA} ms"
    else
        echo "  RESULT ${tag}: FAILED rc=${rc} (not an OOM -- read ${log})"
        tail -5 "${log}" | sed 's/^/      /'
    fi
    # Free the card before the next arm; a lingering context skews the next peak.
    sleep 10
}

echo "tag,local_batch,global_batch,grad_accum,rc,peak_gib,step_med_ms" > "${OUT}/results.csv"
run_arm 1 2 true
run_arm 2 3 true
run_arm 3 4 true
run_arm 4 3 false     # control: reproduce the 2026-09-02 OOM on this node, this session

echo
echo "=== results (card total 39.49 GiB) ==="
column -t -s, "${OUT}/results.csv" 2>/dev/null || cat "${OUT}/results.csv"
echo
"${PY}" - "${OUT}/results.csv" <<'PYEOF'
import csv,sys
rows=list(csv.DictReader(open(sys.argv[1])))
def ok(r): return r["rc"]=="0"
fits=[r for r in rows if ok(r) and r["grad_accum"]=="true"]
best=max((int(r["local_batch"]) for r in fits), default=0)
print("VERDICT")
if best>=4:
    print("  local batch 4 FITS with accumulation on => the paper's GLOBAL BATCH 16 is")
    print("  available on one node, and lr 1e-4 at batch 16 becomes the paper-faithful choice.")
elif best==3:
    print("  local batch 3 fits (global 12) but 4 does not: partial win, still not the")
    print("  paper's batch 16. Global batch 8 vs 12 is then a throughput decision.")
else:
    print("  accumulation does NOT move the ceiling: global batch 8 stands, now on")
    print("  measured ground at the reference's own setting.")
c=[r for r in rows if r["grad_accum"]=="false" and r["local_batch"]=="3"]
if c:
    print("  control (lb3, accumulation OFF) rc=%s peak=%s -- expected to OOM; if it did NOT,"%(c[0]["rc"],c[0]["peak_gib"]))
    print("  the 2026-09-02 ceiling measurement itself needs revisiting.")
PYEOF
echo
echo "ACE2_BATCH_PROBE_OK ${OUT}"
echo "=== done $(date -Iseconds) ==="

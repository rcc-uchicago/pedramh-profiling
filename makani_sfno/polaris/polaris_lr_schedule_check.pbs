#!/bin/bash -l
#PBS -N makani_lr_schedule_check
#PBS -A lighthouse-uchicago
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l filesystems=home:eagle
#PBS -l walltime=00:30:00
#PBS -r n
#PBS -j oe
# ============================================================================
# Gate S1a (polaris_makani_finetune_stability_handoff.md §3a.1): the per-epoch LR
# under makani's warmup + CosineAnnealingLR, read three ways (lr_schedule_check.py):
#   1. simulate makani's own get_scheduler: T_max 1 (3 ep), 22/23 (24 ep), 100 (24 ep);
#   2. the LR saved in C1's 24 real checkpoints and B's last 4 (both T_max 100);
#   3. if LRCHECK_RUN=<expDir> is given: that short run's checkpoints (T_max 1)
#      and the scheduler_T_max its rendered config.json actually carries (proves
#      the SCHED_TMAX knob reaches makani).
# PASS = S1A_OK (every reading matches the closed form). CPU only.
# Submit from makani_sfno/:   qsub [-v LRCHECK_RUN=...] polaris/polaris_lr_schedule_check.pbs
# ============================================================================

cd "${PBS_O_WORKDIR}" || exit 2
MAKANI_ROOT="$(cd "${PBS_O_WORKDIR}" && pwd)"
if [ ! -d "${MAKANI_ROOT}/src/sfno_inference" ]; then
    MAKANI_ROOT="$(cd "${PBS_O_WORKDIR}/.." && pwd)"
fi
REPO="$(cd "${MAKANI_ROOT}/.." && pwd)"

# Env bootstrap copied verbatim from polaris_climate_equiv.pbs.
# shellcheck disable=SC1091
source "${REPO}/polaris_env.sh" || exit 2
# shellcheck disable=SC1091
source "${MAKANI_ROOT}/polaris/polaris_makani_env.sh" || exit 2

if [ ! -x "${SFNO_VENV}/bin/python" ]; then
    echo "ERROR SFNO_VENV_MISSING: ${SFNO_VENV}"
    exit 3
fi
# shellcheck disable=SC1091
source "${SFNO_VENV}/bin/activate"
export PYTHONNOUSERSITE=1
export PYTHONPATH="${MAKANI_ROOT}/src:${PYTHONPATH:-}"
export CUDA_VISIBLE_DEVICES=""
PY="${SFNO_VENV}/bin/python"
CHK="${MAKANI_ROOT}/polaris/lr_schedule_check.py"

MEMBER_ROOT="${MEMBER_ROOT:-/eagle/projects/lighthouse-uchicago/members/mehta5}"
EXPROOT="${MEMBER_ROOT}/runs/makani_mn_scaling/e3sm_mn_scaling"

echo "=== makani_lr_schedule_check: $(date -Iseconds) host=$(hostname) PBS_JOBID=${PBS_JOBID} ==="
ok=1
run() { "${PY}" "${CHK}" "$@" 2>&1 | tee -a "${TMPLOG}" | grep -E "^(torch=|SUMMARY|LR ckpt|LR_SCHEDULE_OK|ERROR)|MISMATCH|Traceback|Error"; }
TMPLOG="${PBS_O_WORKDIR}/lr_schedule_check_${PBS_JOBID%%.*}.log"
: > "${TMPLOG}"

for args in "simulate --epochs 3 --tmax 1" "simulate --epochs 24 --tmax 22 23 100"; do
    echo "--- ${args}"
    # shellcheck disable=SC2086
    run ${args}
    tail -1 "${TMPLOG}" | grep -q "^LR_SCHEDULE_OK" || ok=0
done

C1=()
for i in $(seq 0 23); do C1+=("${EXPROOT}/c1_rollout_full_b16/training_checkpoints/ckpt_mp0_v${i}.tar"); done
echo "--- ckpt C1 (T_max 100)"
run ckpt --tmax 100 "${C1[@]}"
tail -1 "${TMPLOG}" | grep -q "^LR_SCHEDULE_OK" || ok=0
echo "--- ckpt B (T_max 100)"
run ckpt --tmax 100 "${EXPROOT}"/nf4_prod_b16_r1/training_checkpoints/ckpt_mp0_v{0,1,2,3}.tar
tail -1 "${TMPLOG}" | grep -q "^LR_SCHEDULE_OK" || ok=0

if [ -n "${LRCHECK_RUN:-}" ]; then
    echo "--- short run ${LRCHECK_RUN}"
    tmax=$("${PY}" -c "import json,sys;print(json.load(open(sys.argv[1]))['scheduler_T_max'])" "${LRCHECK_RUN}/config.json")
    echo "rendered config scheduler_T_max=${tmax}"
    [ "${tmax}" = "1" ] || { echo "ERROR SCHED_TMAX_NOT_RENDERED got=${tmax}"; ok=0; }
    run ckpt --tmax 1 "${LRCHECK_RUN}"/training_checkpoints/ckpt_mp0_v*.tar
    tail -1 "${TMPLOG}" | grep -q "^LR_SCHEDULE_OK" || ok=0
fi

[ "${ok}" -eq 1 ] && echo "S1A_OK" || echo "ERROR S1A_FAILED (see ${TMPLOG})"
echo "=== makani_lr_schedule_check done $(date -Iseconds) ==="

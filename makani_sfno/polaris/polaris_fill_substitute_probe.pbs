#!/bin/bash -l
#PBS -N makani_fill_probe
#PBS -A lighthouse-uchicago
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l filesystems=home:eagle
#PBS -l walltime=00:30:00
#PBS -r n
#PBS -j oe
# Validation-only, no training: fill_substitute_probe.py on prod1n_b32_sgdr's best
# checkpoint. PASS token: FILL_SUBSTITUTE_PROBE_OK (tiers are pre-registered in
# the script's docstring). Submit from makani_sfno/.
set -u
cd "${PBS_O_WORKDIR}" || exit 2
MAKANI_ROOT="$(cd "${PBS_O_WORKDIR}" && pwd)"
[ -d "${MAKANI_ROOT}/src/sfno_training" ] || { echo "ERROR MAKANI_ROOT_NOT_FOUND: submit from makani_sfno/"; exit 2; }
REPO="$(cd "${MAKANI_ROOT}/.." && pwd)"
JOBID="${PBS_JOBID%%.*}"

# ---- environment (verbatim from polaris_makani_multinode_scaling.pbs) ---------
# shellcheck disable=SC1091
source "${REPO}/polaris_env.sh" || exit 2
# shellcheck disable=SC1091
source "${MAKANI_ROOT}/polaris/polaris_makani_env.sh" || exit 2
if [ ! -x "${SFNO_VENV}/bin/python" ]; then echo "ERROR SFNO_VENV_MISSING: ${SFNO_VENV}"; exit 3; fi
# shellcheck disable=SC1091
source "${SFNO_VENV}/bin/activate"
export PYTHONNOUSERSITE=1
PY="${SFNO_VENV}/bin/python"
export PYTHONPATH="${MAKANI_ROOT}/src:${PYTHONPATH:-}"
export HDF5_USE_FILE_LOCKING=FALSE
# -----------------------------------------------------------------------------

RUN="${MEMBER_ROOT}/runs/makani_mn_scaling/e3sm_mn_scaling/prod1n_b32_sgdr"
PACK="${MEMBER_ROOT}/data/e3sm_makani_alldata_production"
"${PY}" "${MAKANI_ROOT}/polaris/fill_substitute_probe.py" --run-dir "${RUN}" \
    --ckpt "${RUN}/training_checkpoints/best_ckpt_mp0.tar" --data "${PACK}/valid" \
    --pack "${PACK}" --n-samples "${N_SAMPLES:-64}" \
    --out "${MEMBER_ROOT}/runs/makani_probe/fill_substitute/${JOBID}"

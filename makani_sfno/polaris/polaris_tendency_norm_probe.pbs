#!/bin/bash -l
#PBS -N makani_tendnorm_probe
#PBS -A lighthouse-uchicago
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l filesystems=home:eagle
#PBS -l walltime=00:45:00
#PBS -r n
#PBS -j oe
# ============================================================================
# ADVERSARIAL PROBE for polaris_makani_ace2_ports_handoff.md §3.
#
# That section argues -- from a three-week-old code quote and an ASSUMPTION about
# how delta_c/sigma_c is distributed -- that our loss is nearly blind to slow
# channels, that this is why SOILWATER_10CM drifts, and that
# `temp_diff_normalization: True` is therefore the indicated fix.  None of that
# has been measured.  This job measures it, and is written to FALSIFY.
#
# Five pre-registered hypotheses with thresholds fixed in the script before any
# number existed (tendency_norm_probe.py's docstring):
#   H1 the mechanism is really in the INSTALLED makani, shaped sigma_c/delta_c
#   H2 r_c = delta_c/sigma_c spans >= 1.5 orders of magnitude
#   H3 the land reservoirs are in the bottom quartile of r_c
#   H4 the 336 h bias fraction tracks small r_c (Spearman <= -0.30)  <- the one that matters
#   H5 ... or the train->test climate shift explains it better, in which case
#      port B is DEMOTED, not promoted
#
# H2 and H3 can both hold while the drift lives somewhere else entirely, which is
# exactly why H4 exists and why H2/H3 alone must not be read as a result.
#
# CPU-ONLY ON PURPOSE: reductions over ~6 GB of HDF5. Same reasoning as
# polaris_score_k56.pbs. (makani is imported for H1, which pulls torch in -- hence
# a compute node and not a login node, CLAUDE.md #3.)
#
# Knobs (-v):
#   PACK        pack root                  (default $MEMBER_ROOT/data/e3sm_makani_alldata_production)
#   K56         k56_metrics.h5             (default the prod1n_b32_sgdr_K56 scores)
#   TRAIN_YEAR  year sampled for delta_c   (default 2044, the last train year)
#   TEST_YEAR   year sampled for H5        (default 2048)
#   WINDOWS     evenly spaced windows      (default 4 -- one per season)
#   WINDOW_LEN  samples per window         (default 60)
#
# PASS = TENDENCY_PROBE_OK, which means ONLY that the probe ran on real data.
# The verdicts are the five H<n> lines; green-with-three-falsified is a SUCCESS
# (CLAUDE.md #14 -- the token is not the answer here, the verdicts are).
#
# Submit from makani_sfno/:
#   qsub polaris/polaris_tendency_norm_probe.pbs
# ============================================================================

cd "${PBS_O_WORKDIR}" || exit 2
MAKANI_ROOT="$(cd "${PBS_O_WORKDIR}" && pwd)"
if [ ! -d "${MAKANI_ROOT}/src/sfno_eval" ]; then
    MAKANI_ROOT="$(cd "${PBS_O_WORKDIR}/.." && pwd)"
fi
if [ ! -d "${MAKANI_ROOT}/src/sfno_eval" ]; then
    echo "ERROR MAKANI_ROOT_NOT_FOUND: PBS_O_WORKDIR=${PBS_O_WORKDIR} derived=${MAKANI_ROOT}"
    exit 2
fi
REPO="$(cd "${MAKANI_ROOT}/.." && pwd)"

# Env bootstrap copied verbatim from polaris_score_k56.pbs -- module ordering
# differs per model on purpose (CLAUDE.md, "Writing a new submission script").
# shellcheck disable=SC1091
source "${REPO}/polaris_env.sh" || exit 2
# shellcheck disable=SC1091
source "${MAKANI_ROOT}/polaris/polaris_makani_env.sh" || exit 2

if [ ! -x "${SFNO_VENV}/bin/python" ]; then
    echo "ERROR SFNO_VENV_MISSING: ${SFNO_VENV}"
    exit 3
fi
# shellcheck disable=SC1091
source "${SFNO_VENV}/bin/activate"
# A --system-site-packages venv re-enables the USER site, which site.py ranks
# ABOVE the venv.
export PYTHONNOUSERSITE=1
export PYTHONPATH="${MAKANI_ROOT}/src:${PYTHONPATH:-}"
export HDF5_USE_FILE_LOCKING=FALSE
export CUDA_VISIBLE_DEVICES=""
PY="${SFNO_VENV}/bin/python"

MEMBER_ROOT="${MEMBER_ROOT:-/eagle/projects/lighthouse-uchicago/members/mehta5}"
PACK="${PACK:-${MEMBER_ROOT}/data/e3sm_makani_alldata_production}"
K56="${K56:-${MEMBER_ROOT}/runs/makani_eval/prod1n_b32_sgdr_K56/scores/k56_metrics.h5}"
TRAIN_YEAR="${TRAIN_YEAR:-2044}"
TEST_YEAR="${TEST_YEAR:-2048}"
WINDOWS="${WINDOWS:-4}"
WINDOW_LEN="${WINDOW_LEN:-60}"
OUT_DIR="${OUT_DIR:-${MEMBER_ROOT}/runs/makani_probe/tendency_norm/${PBS_JOBID%%.*}}"

for _p in "${PACK}/stats/global_stds.npy" "${PACK}/train/${TRAIN_YEAR}.h5" \
          "${PACK}/test/${TEST_YEAR}.h5"; do
    if [ ! -e "${_p}" ]; then
        echo "ERROR PROBE_INPUT_MISSING: ${_p}"
        exit 3
    fi
done
if [ ! -e "${K56}" ]; then
    echo "WARN PROBE_NO_K56: ${K56} absent -- H4/H5 will be skipped, and those are"
    echo "     the hypotheses that decide anything. Fix the path rather than reading H2/H3 alone."
    K56=""
fi

echo "=== makani_tendnorm_probe: $(date -Iseconds) ==="
echo "host=$(hostname)  PBS_JOBID=${PBS_JOBID}"
echo "pack=${PACK}  train_year=${TRAIN_YEAR}  test_year=${TEST_YEAR}"
echo "windows=${WINDOWS} x ${WINDOW_LEN}  k56=${K56:-<none>}"
echo "out_dir=${OUT_DIR}"
makani_env_report
echo

SHA7="$(cd "${REPO}" && git rev-parse --short=7 HEAD 2>/dev/null || echo unknown)"

EXTRA=()
if [ -n "${K56}" ]; then
    EXTRA+=(--k56-h5 "${K56}")
fi

set -x
"${PY}" "${MAKANI_ROOT}/polaris/tendency_norm_probe.py" \
    --pack-root "${PACK}" \
    --train-year "${TRAIN_YEAR}" \
    --test-year "${TEST_YEAR}" \
    --windows "${WINDOWS}" \
    --window-len "${WINDOW_LEN}" \
    --out-dir "${OUT_DIR}" \
    --provenance "job=${PBS_JOBID%%.*} sha=${SHA7}" \
    "${EXTRA[@]}"
rc=$?
set +x

echo "--- tendency_norm_probe rc=${rc} ---"
if [ ${rc} -ne 0 ]; then
    echo "ERROR TENDENCY_PROBE_FAILED rc=${rc}"
    exit 5
fi
for _f in tendency_norm_probe.csv tendency_norm_probe.json; do
    if [ ! -s "${OUT_DIR}/${_f}" ]; then
        echo "ERROR TENDENCY_PROBE_NO_OUTPUT: ${OUT_DIR}/${_f} missing or empty"
        exit 6
    fi
done

echo "=== makani_tendnorm_probe done $(date -Iseconds) ==="

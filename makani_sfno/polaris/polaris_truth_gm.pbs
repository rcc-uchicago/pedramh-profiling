#!/bin/bash -l
#PBS -N makani_truth_gm
#PBS -A lighthouse-uchicago
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -r n
#PBS -j oe
# ============================================================================
# Truth annual global means 2015-2047 for the drift census (prereg §4.4,
# docs/makani-knowledge d06b4916 + amendment 2 b705144a). h5py, every 5th 6-h
# sample, 8 processes. Gate TRUTH_GM_EQUIV_OK: matches the loader-built truth maps
# of 2045-2047 ($EVAL/window_truth/truth_<Y>.npz) within 0.1 interannual SD.
# 2048-2049 are NOT read (sealed reporting window).
# Submit from makani_sfno/:  qsub polaris/polaris_truth_gm.pbs
# PASS = TRUTH_GM_OK + TRUTH_GM_EQUIV_OK
# ============================================================================

cd "${PBS_O_WORKDIR}" || exit 2
MAKANI_ROOT="$(cd "${PBS_O_WORKDIR}" && pwd)"
if [ ! -d "${MAKANI_ROOT}/src/sfno_inference" ]; then
    MAKANI_ROOT="$(cd "${PBS_O_WORKDIR}/.." && pwd)"
fi
REPO="$(cd "${MAKANI_ROOT}/.." && pwd)"

# Env bootstrap copied verbatim from polaris_climate_run.pbs.
# shellcheck disable=SC1091
source "${REPO}/polaris_env.sh" || exit 2
# shellcheck disable=SC1091
source "${MAKANI_ROOT}/polaris/polaris_makani_env.sh" || exit 2

if [ ! -x "${SFNO_VENV}/bin/python" ]; then
    echo "ERROR SFNO_VENV_MISSING: ${SFNO_VENV}"
    exit 3
fi
# shellcheck disable=SC1091
source "${SFNO_VENV}/bin/activate"
export PYTHONNOUSERSITE=1
export PYTHONPATH="${MAKANI_ROOT}/src:${PYTHONPATH:-}"
export HDF5_USE_FILE_LOCKING=FALSE
PY="${SFNO_VENV}/bin/python"

MEMBER_ROOT="${MEMBER_ROOT:-/eagle/projects/lighthouse-uchicago/members/mehta5}"
EVAL="${MEMBER_ROOT}/runs/makani_eval"
PACK="${MEMBER_ROOT}/data/e3sm_makani_alldata_production"
echo "=== makani_truth_gm: $(date -Iseconds) host=$(hostname) PBS_JOBID=${PBS_JOBID} ==="
CUDA_VISIBLE_DEVICES="" "${PY}" "${MAKANI_ROOT}/polaris/truth_annual_global_means.py" \
    --pack "${PACK}" --years $(seq 2015 2047) --stride 5 --workers 8 \
    --out "${EVAL}/window_truth/truth_annual_gm_2015_2047.npz" \
    --check-truth-dir "${EVAL}/window_truth"
echo "=== makani_truth_gm done $(date -Iseconds) ==="

#!/bin/bash -l
#PBS -N makani_climate_run
#PBS -A lighthouse-uchicago
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -r n
#PBS -j oe
# ============================================================================
# jesswan's multi-year protocol, inference only: 8 members per checkpoint,
# initialised Oct 1, 5, ..., 29 2044 (frames 1092 + 16*i, noleap), each rolled to
# 2049-12-31 18:00, scored from 2045-01-01 00:00 (after the Oct-Dec discard).
# Lead count per member = 7667 - 16*i.
#
# Checkpoints (ARMS, default "A B"):
#   A = prod1n_b32_sgdr/best_ckpt_mp0.tar  (single-step, epoch 243)
#   B = nf4_prod_b16_r1/best_ckpt_mp0.tar  (A + 1 epoch of n_future=4 fine-tune)
#   Override B's file with -v CKPT_B=<path> (e.g. ckpt_mp0_v3.tar = epoch 24).
#
# ARMS accepts any arm name, not just A/B: for an arm not named "A" or "B",
# set -v RUNDIR_<ARM>=<run dir name under EXPROOT> -v CKPT_<ARM>=<checkpoint path>
# (both required -- the job refuses an arm with either missing). Optionally
# -v FLAGS_<ARM>="<extra climate_rollout.py args>" (e.g. "--dry-air-fix on",
# "--feedback-fp32", "--force-positive relhum") for a diagnostic variant of the
# same checkpoint. makani-B-continuation handoff (2026-10-02) §2.
#
# Four members at a time, one per GPU; each PID is waited on individually. A
# member that goes non-finite stops, writes its outputs and prints
# CLIMATE_ROLLOUT_TRUNCATED -- a measurement, not a failure.
#
# This writes the per-member NetCDFs only. Scoring against truth needs the
# protocol handoff's §4a references + §4c aggregator + §4d pre-registration.
#
# PASS = CLIMATE_RUN_OK (every member printed OK or TRUNCATED and has its .nc).
# Submit from makani_sfno/:   qsub polaris/polaris_climate_run.pbs
# ============================================================================

cd "${PBS_O_WORKDIR}" || exit 2
MAKANI_ROOT="$(cd "${PBS_O_WORKDIR}" && pwd)"
if [ ! -d "${MAKANI_ROOT}/src/sfno_inference" ]; then
    MAKANI_ROOT="$(cd "${PBS_O_WORKDIR}/.." && pwd)"
fi
REPO="$(cd "${MAKANI_ROOT}/.." && pwd)"

# Env bootstrap copied verbatim from polaris_eval_inference.pbs -- module
# ordering differs per model on purpose (CLAUDE.md, "Writing a new submission
# script").
# shellcheck disable=SC1091
source "${REPO}/polaris_env.sh" || exit 2
# shellcheck disable=SC1091
source "${MAKANI_ROOT}/polaris/polaris_makani_env.sh" || exit 2

if [ ! -x "${SFNO_VENV}/bin/python" ]; then
    echo "ERROR SFNO_VENV_MISSING: ${SFNO_VENV}"
    exit 3
fi
# shellcheck disable=SC1091
source "${SFNO_VENV}/bin/activate"
export PYTHONNOUSERSITE=1
export PYTHONPATH="${MAKANI_ROOT}/src:${PYTHONPATH:-}"
export HDF5_USE_FILE_LOCKING=FALSE
PY="${SFNO_VENV}/bin/python"

MEMBER_ROOT="${MEMBER_ROOT:-/eagle/projects/lighthouse-uchicago/members/mehta5}"
EXPROOT="${MEMBER_ROOT}/runs/makani_mn_scaling/e3sm_mn_scaling"
ARMS="${ARMS:-A B}"
N_MEMBERS="${N_MEMBERS:-8}"
MEMBER_STRIDE="${MEMBER_STRIDE:-16}"
START_FRAME0="${START_FRAME0:-1092}"
N_STEPS0="${N_STEPS0:-7667}"          # Oct 1 2044 00:00 -> 2049-12-31 18:00
CHUNK_LEN="${CHUNK_LEN:-40}"
SNAPSHOT_EVERY="${SNAPSHOT_EVERY:-0}"
CKPT_A="${CKPT_A:-${EXPROOT}/prod1n_b32_sgdr/training_checkpoints/best_ckpt_mp0.tar}"
CKPT_B="${CKPT_B:-${EXPROOT}/nf4_prod_b16_r1/training_checkpoints/best_ckpt_mp0.tar}"
RUNDIR_A="${RUNDIR_A:-prod1n_b32_sgdr}"
RUNDIR_B="${RUNDIR_B:-nf4_prod_b16_r1}"
declare -A RUNS=()
declare -A CKPTS=()
declare -A FLAGS=()
for arm in ${ARMS}; do
    rundir_var="RUNDIR_${arm}"; ckpt_var="CKPT_${arm}"; flags_var="FLAGS_${arm}"
    RUNS[$arm]="${!rundir_var:-}"
    CKPTS[$arm]="${!ckpt_var:-}"
    FLAGS[$arm]="${!flags_var:-}"
    if [ -z "${RUNS[$arm]}" ] || [ -z "${CKPTS[$arm]}" ]; then
        echo "ERROR CLIMATE_RUN_ARM_UNDEFINED arm=${arm} (set RUNDIR_${arm} and CKPT_${arm})"
        exit 4
    fi
done
JOB="${PBS_JOBID%%.*}"
OUT_ROOT="${OUT_ROOT:-${MEMBER_ROOT}/runs/makani_eval/climate_protocol_${JOB}}"
SHA="$(cd "${REPO}" && git rev-parse --short=12 HEAD 2>/dev/null || echo unknown)"
mkdir -p "${OUT_ROOT}"

echo "=== makani_climate_run: $(date -Iseconds) ==="
echo "host=$(hostname)  PBS_JOBID=${PBS_JOBID}  sha=${SHA}  arms='${ARMS}'  members=${N_MEMBERS}  out=${OUT_ROOT}"
for arm in ${ARMS}; do echo "ckpt ${arm}: ${CKPTS[$arm]} flags='${FLAGS[$arm]}'"; done
makani_env_report
echo

TASKS=()
for arm in ${ARMS}; do
    for ((i = 0; i < N_MEMBERS; i++)); do TASKS+=("${arm}:${i}"); done
done

ok=1
# Launched inline, NOT via $(function): a command substitution runs in a subshell,
# the member would not be this shell's child, and `wait` could not see it.
for ((t = 0; t < ${#TASKS[@]}; t += 4)); do
    declare -A PIDS=()
    for ((g = 0; g < 4 && t + g < ${#TASKS[@]}; g++)); do
        IFS=: read -r arm i <<< "${TASKS[$((t + g))]}"
        frame=$((START_FRAME0 + MEMBER_STRIDE * i))
        n=$((N_STEPS0 - MEMBER_STRIDE * i))
        tag="${arm}$(printf '%02d' "${i}")"
        # shellcheck disable=SC2086  # FLAGS[$arm] is deliberately word-split (per-arm extra args)
        CUDA_VISIBLE_DEVICES="${g}" "${PY}" -m torch.distributed.run --standalone \
            --nproc_per_node=1 "${MAKANI_ROOT}/scripts/climate_rollout.py" \
            --run-dir "${EXPROOT}/${RUNS[$arm]}" --ckpt "${CKPTS[$arm]}" \
            --start 2044 "${frame}" --n-steps "${n}" --score-start 2045 0 \
            --member-id "${tag}" --chunk-len "${CHUNK_LEN}" --snapshot-every "${SNAPSHOT_EVERY}" \
            --years-dir "${OUT_ROOT}/years/${tag}" \
            --out "${OUT_ROOT}/member_${tag}.nc" --git-sha "${SHA}" ${FLAGS[$arm]} \
            > "${OUT_ROOT}/member_${tag}.log" 2>&1 &
        PIDS[$tag]=$!
        echo "launched ${tag} frame=${frame} n=${n} gpu=${g} pid=${PIDS[$tag]} ($(date +%T))"
    done
    for tag in $(printf '%s\n' "${!PIDS[@]}" | sort); do
        wait "${PIDS[$tag]}"
        rc=$?
        log="${OUT_ROOT}/member_${tag}.log"
        line=$(grep -E "^(CLIMATE_ROLLOUT_(OK|TRUNCATED)|ERROR)" "${log}" | tail -1)
        perf=$(grep -E "^PERF" "${log}" | tail -1)
        echo "  ${tag} rc=${rc} ${perf} :: ${line}"
        if ! grep -qE "^CLIMATE_ROLLOUT_(OK|TRUNCATED)" "${log}" || [ ! -f "${OUT_ROOT}/member_${tag}.nc" ]; then
            echo "ERROR CLIMATE_MEMBER_FAILED ${tag} (see ${log})"; ok=0
        fi
    done
    unset PIDS
done

echo "--- readout ($(date -Iseconds)) ---"
CUDA_VISIBLE_DEVICES="" "${PY}" "${MAKANI_ROOT}/polaris/climate_smoke_readout.py" \
    "${OUT_ROOT}"/member_*.nc 2>&1 | tee "${OUT_ROOT}/readout.log" | tail -80

[ "${ok}" -eq 1 ] && echo "CLIMATE_RUN_OK arms='${ARMS}' members=${N_MEMBERS} out=${OUT_ROOT}"
echo "=== makani_climate_run done $(date -Iseconds) ==="

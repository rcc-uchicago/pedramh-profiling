#!/bin/bash -l
#PBS -N makani_g_smoke
#PBS -A lighthouse-uchicago
#PBS -q debug
#PBS -l select=2:system=polaris
#PBS -l place=scatter
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -r n
#PBS -j oe
# ============================================================================
# PORT G smoke (e3sm_alldata_ace2vars.yaml, 83-in / 77-out, on the 2020-2044 view).
# The G analogue of polaris_makani_ports_smoke.pbs §4 (F's 7646684), in one debug
# job, three sections, each keyed on its own token:
#
#   1. TRAIN  2 nodes x local 4 = global 32 (G's production batch), 20 steps x 2
#             epochs, EMA=1, through the PRODUCTION launcher.     -> G_TRAIN_SMOKE_OK
#             Requires: CHANNEL_SUBSET_GATE_OK; the trainer's line
#             "CHANNEL_SUBSET in=76 out=77 of a 101-channel pack; dropped pack idx
#             [2, 3, 4, 5, 8, 9, 64, ..., 81]"; "train samples available: 36500"
#             (the view, not the 43,800 of 2015-2044); FABRIC_CXI_CONFIRMED (G's
#             encoder broadcast is 384x83, a message size never sent before -- the
#             class of size that wedged the first ALLDATA smoke, 7565896);
#             EMA_ASSERT_OK; MAKANI_MN_SCALING_OK; no nan/inf loss line.
#   2. ROLLOUT the climate driver from section 1's best_ckpt, 2044 f1092, 380 leads:
#             crosses 2044.h5 (view train/) -> 2045.h5 (view valid/) at step 368,
#             reads G's stats from the view by out_channels.     -> G_ROLLOUT_SMOKE_OK
#             CLIMATE_ROLLOUT_OK with the step-368 handoff, or CLIMATE_ROLLOUT_TRUNCATED
#             (a 40-step model may blow up: machinery, not skill); a 77-channel NetCDF.
#   3. FINETUNE the arm launcher's OWN lrcheck vars for G (submit_subset_finetune_arm.sh
#             G lrcheck, DRY_RUN) run inline: MULTISTEP=5 (n_future 4) at 77 channels,
#             warm start from section 1, 3 epochs x 20 steps, SCHED_TMAX=1.
#                                                                  -> G_FINETUNE_SMOKE_OK
#             Requires FINETUNE_BASE_OK n_out=77 pack=<view>, CHANNEL_SUBSET_GATE_OK,
#             MAKANI_MN_SCALING_OK, no nan/inf, and LR_SCHEDULE_OK on its checkpoints
#             (4e-4 x 0.01 -> 4e-4 -> 1e-6, lr_schedule_check.py).
#
# PASS = G_SMOKE_OK 3/3 on the last line. rc is not the result (CLAUDE.md #14).
# Needs the view: submit with -W depend=afterok:<trainview job>.
# Submit from makani_sfno/:   qsub [-W depend=afterok:<id>] polaris/polaris_g_smoke.pbs
# ============================================================================
set -u
cd "${PBS_O_WORKDIR}" || exit 2
MAKANI_ROOT="$(cd "${PBS_O_WORKDIR}" && pwd)"
[ -d "${MAKANI_ROOT}/src/sfno_training" ] || { echo "ERROR MAKANI_ROOT_NOT_FOUND: submit from makani_sfno/"; exit 2; }
REPO="$(cd "${MAKANI_ROOT}/.." && pwd)"
JOBID="${PBS_JOBID%%.*}"

# ---- environment (verbatim from polaris_makani_ports_smoke.pbs) ---------------
# shellcheck disable=SC1091
source "${REPO}/polaris_env.sh" || exit 2
# shellcheck disable=SC1091
source "${MAKANI_ROOT}/polaris/polaris_makani_env.sh" || exit 2

if [ ! -x "${SFNO_VENV}/bin/python" ]; then
    echo "ERROR SFNO_VENV_MISSING: ${SFNO_VENV}"
    echo "  Build it on a LOGIN node:  bash ${REPO}/polaris_setup_sfno_venv.sh"
    exit 3
fi
# shellcheck disable=SC1091
source "${SFNO_VENV}/bin/activate"
export PYTHONNOUSERSITE=1
PY="${SFNO_VENV}/bin/python"

if [ ! -d "${MAKANI_H5PY_OVERLAY:-/nonexistent}" ]; then
    echo "ERROR MAKANI_H5PY_OVERLAY_MISSING: ${MAKANI_H5PY_OVERLAY:-<unset>}"
    exit 3
fi

# sfno_training lives under <root>/src -- NOT <root>.
export PYTHONPATH="${MAKANI_ROOT}/src:${PYTHONPATH:-}"
export WANDB_MODE="${WANDB_MODE:-offline}"
export HDF5_USE_FILE_LOCKING=FALSE
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# -----------------------------------------------------------------------------

VIEW="${G_PACK:-${MEMBER_ROOT}/data/e3sm_makani_alldata_train2020_2044}"
EXPROOT="${MEMBER_ROOT}/runs/makani_mn_scaling/e3sm_mn_scaling"
OUT="${MEMBER_ROOT}/runs/makani_probe/g_smoke/${JOBID}"
SHA="$(cd "${REPO}" && git rev-parse --short=12 HEAD 2>/dev/null || echo unknown)"
mkdir -p "${OUT}" || exit 2
echo "=== makani_g_smoke: $(date -Iseconds) job=${JOBID} sha=${SHA} ==="
echo "view=${VIEW}  out=${OUT}"
grep -q '"train_years": \[' "${VIEW}/metadata/data.json" 2>/dev/null \
    || { echo "ERROR TRAINVIEW_MISSING: ${VIEW} (polaris_pack_alldata_trainview.pbs first)"; exit 3; }
declare -A OK

# pack indices G drops, in the trainer's own format
WANT_SUB="CHANNEL_SUBSET in=76 out=77 of a 101-channel pack; dropped pack idx $("${PY}" -c \
    'print([2, 3, 4, 5, 8, 9] + list(range(64, 82)))')"
nan_lines() { grep -ciE "loss.*\b(nan|inf)\b" "$1" 2>/dev/null || true; }

# ---- 1. TRAIN ------------------------------------------------------------------
echo "=== 1. G training smoke: 2 nodes x local 4, 20 steps x 2 epochs, EMA=1 ==="
RUN1="smoke_g_${JOBID}"
CONFIG_YAML=e3sm_alldata_ace2vars.yaml PACK="${VIEW}" RUN_NUM="${RUN1}" \
STEPS=20 LOCAL_BATCH=4 EPOCHS=2 EVAL_SAMPLES=64 EMA=1 WANDB=0 \
MAKANI_SCALING_CSV="${MEMBER_ROOT}/bench/makani_ports_smoke.csv" \
    bash "${MAKANI_ROOT}/polaris/polaris_makani_multinode_scaling.pbs" > "${OUT}/train.out" 2>&1
rc1=$?
TLOG1="${MEMBER_ROOT}/runs/makani_mn_scaling/${RUN1}.log"
grep -E "CHANNEL_SUBSET_GATE|ERROR|FABRIC_|EMA_ASSERT_OK|MAKANI_MN_SCALING_OK|train samples available" \
    "${OUT}/train.out" | tail -12
sub1=$(grep -m1 -oE "CHANNEL_SUBSET in=[0-9]+ out=[0-9]+ of a [0-9]+-channel pack; dropped pack idx \[[0-9, ]*\]" "${TLOG1}" 2>/dev/null)
echo "subset line: ${sub1:-<absent>}"
n1=$(nan_lines "${TLOG1}")
CKPT1="${EXPROOT}/${RUN1}/training_checkpoints/best_ckpt_mp0.tar"
if grep -q "CHANNEL_SUBSET_GATE_OK" "${OUT}/train.out" \
   && [ "${sub1}" = "${WANT_SUB}" ] \
   && grep -q "train samples available: 36500 " "${OUT}/train.out" \
   && grep -q "FABRIC_CXI_CONFIRMED" "${OUT}/train.out" \
   && grep -q "EMA_ASSERT_OK" "${OUT}/train.out" \
   && grep -q "MAKANI_MN_SCALING_OK" "${OUT}/train.out" \
   && [ "${n1:-0}" = "0" ] && [ -f "${CKPT1}" ]; then
    OK[train]=1; echo "G_TRAIN_SMOKE_OK rc=${rc1} run=${EXPROOT}/${RUN1}"
else
    echo "ERROR G_TRAIN_SMOKE_FAILED rc=${rc1} nan_lines=${n1:-?} ckpt=$([ -f "${CKPT1}" ] && echo yes || echo no)" \
         "(see ${OUT}/train.out, ${TLOG1})"
fi

if [ -z "${OK[train]:-}" ]; then
    echo "ERROR G_SMOKE_INCOMPLETE ok= (sections 2 and 3 need section 1's checkpoint)"
    exit 1
fi

# ---- 2. ROLLOUT ----------------------------------------------------------------
echo "=== 2. climate-driver rollout from ${RUN1}: 2044 f1092, 380 leads ==="
CUDA_VISIBLE_DEVICES=0 "${PY}" -m torch.distributed.run --standalone --nproc_per_node=1 \
    "${MAKANI_ROOT}/scripts/climate_rollout.py" \
    --run-dir "${EXPROOT}/${RUN1}" --ckpt "${CKPT1}" \
    --start 2044 1092 --n-steps 380 --member-id smoke_G --chunk-len 40 \
    --years-dir "${OUT}/years" --out "${OUT}/member_G.nc" --git-sha "${SHA}" \
    > "${OUT}/rollout.log" 2>&1
rc2=$?
grep -E "^(member=|HANDOFF|STABILITY|CLIMATE_ROLLOUT_|ERROR)|Error" "${OUT}/rollout.log" | head -10
n_ch=$("${PY}" -c "import netCDF4, sys; print(len(netCDF4.Dataset(sys.argv[1])['channel']))" \
       "${OUT}/member_G.nc" 2>/dev/null)
echo "netcdf channels: ${n_ch:-<unreadable>}"
if grep -q "^CLIMATE_ROLLOUT_OK" "${OUT}/rollout.log"; then
    grep -q "^HANDOFF step=368 .*forcing_direct_match=True" "${OUT}/rollout.log" && h=1 || h=0
    [ "${h}" = 1 ] || echo "ERROR G_ROLLOUT_HANDOFF_NOT_368"
elif grep -q "^CLIMATE_ROLLOUT_TRUNCATED" "${OUT}/rollout.log"; then
    h=1; echo "NOTE truncated (non-finite) before 380 leads: machinery exercised up to there"
else
    h=0
fi
if [ "${h}" = 1 ] && [ "${n_ch:-0}" = "77" ]; then
    OK[rollout]=1; echo "G_ROLLOUT_SMOKE_OK rc=${rc2} nc=${OUT}/member_G.nc"
else
    echo "ERROR G_ROLLOUT_SMOKE_FAILED rc=${rc2} channels=${n_ch:-?} (see ${OUT}/rollout.log)"
fi

# ---- 3. FINETUNE (the arm launcher's own vars, run inline) ---------------------
echo "=== 3. fine-tune mechanics: submit_subset_finetune_arm.sh G lrcheck (inline) ==="
# The launcher refuses fabric variables in ITS environment (a login-shell guard);
# a compute node's modules may set some, and the harness below sets its own anyway.
DRY=$(env -u OFI_PLUGIN -u OFI_LIBFABRIC -u NCCL_PROTO -u CXI_RDZV -u OFI_NCCL_PROGRESS_MODEL \
          -u NCCL_NET -u FI_PROVIDER DRY_RUN=1 PRETRAINED_CKPT="${CKPT1}" \
      bash "${MAKANI_ROOT}/polaris/submit_subset_finetune_arm.sh" G lrcheck "smoke${JOBID}" 2>&1)
echo "${DRY}" | grep -E "FINETUNE_BASE_|FINETUNE_ARM_DRY_RUN_OK|ERROR"
V=$(echo "${DRY}" | grep "^DRY_RUN" | grep -oE " -v [^ ]+" | sed 's/^ -v //')
TAG3="fsG_lrcheck_nf4_b8_rsmoke${JOBID}"
if echo "${DRY}" | grep -q "^FINETUNE_BASE_OK n_out=77 pack=${VIEW} " && [ -n "${V}" ]; then
    # shellcheck disable=SC2046
    env $(echo "${V}" | tr ',' ' ') \
        bash "${MAKANI_ROOT}/polaris/polaris_makani_multinode_scaling.pbs" > "${OUT}/finetune.out" 2>&1
    rc3=$?
    TLOG3="${MEMBER_ROOT}/runs/makani_mn_scaling/${TAG3}.log"
    grep -E "CHANNEL_SUBSET_GATE|ERROR|MAKANI_MN_SCALING_OK" "${OUT}/finetune.out" | tail -6
    n3=$(nan_lines "${TLOG3}")
    "${PY}" "${MAKANI_ROOT}/polaris/lr_schedule_check.py" ckpt --tmax 1 \
        "${EXPROOT}/${TAG3}"/training_checkpoints/ckpt_mp0_v*.tar > "${OUT}/lrcheck.log" 2>&1
    grep -E "^(LR ckpt|LR_SCHEDULE_OK|ERROR)" "${OUT}/lrcheck.log" | tail -5
    if grep -q "CHANNEL_SUBSET_GATE_OK" "${OUT}/finetune.out" \
       && grep -q "MAKANI_MN_SCALING_OK" "${OUT}/finetune.out" \
       && [ "${n3:-0}" = "0" ] \
       && tail -1 "${OUT}/lrcheck.log" | grep -q "^LR_SCHEDULE_OK"; then
        OK[finetune]=1; echo "G_FINETUNE_SMOKE_OK rc=${rc3} run=${EXPROOT}/${TAG3}"
    else
        echo "ERROR G_FINETUNE_SMOKE_FAILED rc=${rc3} nan_lines=${n3:-?} (see ${OUT}/finetune.out, ${OUT}/lrcheck.log)"
    fi
else
    echo "ERROR G_FINETUNE_SMOKE_FAILED: launcher dry run did not accept section 1's checkpoint"
fi

echo
echo "sections ok: ${!OK[*]}"
if [ "${#OK[@]}" -eq 3 ]; then
    echo "G_SMOKE_OK 3/3 job=${JOBID} out=${OUT}"
else
    echo "ERROR G_SMOKE_INCOMPLETE ${#OK[@]}/3 ok=${!OK[*]} (want train rollout finetune)"
    exit 1
fi

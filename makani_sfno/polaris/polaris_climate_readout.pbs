#!/bin/bash -l
#PBS -N makani_climate_readout
#PBS -A lighthouse-uchicago
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l filesystems=home:eagle
#PBS -l walltime=00:15:00
#PBS -r n
#PBS -j oe
# Read out climate-driver member NetCDFs (G4). CPU only; netCDF4 needs the
# compute-node modules, hence a job, not the login node.
#   qsub -v NC_DIR=<dir with member_*.nc> polaris/polaris_climate_readout.pbs
# PASS = CLIMATE_READOUT_OK

cd "${PBS_O_WORKDIR}" || exit 2
MAKANI_ROOT="$(cd "${PBS_O_WORKDIR}" && pwd)"
if [ ! -d "${MAKANI_ROOT}/src/sfno_inference" ]; then
    MAKANI_ROOT="$(cd "${PBS_O_WORKDIR}/.." && pwd)"
fi
REPO="$(cd "${MAKANI_ROOT}/.." && pwd)"

# Env bootstrap copied verbatim from polaris_eval_inference.pbs.
# shellcheck disable=SC1091
source "${REPO}/polaris_env.sh" || exit 2
# shellcheck disable=SC1091
source "${MAKANI_ROOT}/polaris/polaris_makani_env.sh" || exit 2

if [ ! -x "${SFNO_VENV}/bin/python" ]; then
    echo "ERROR SFNO_VENV_MISSING: ${SFNO_VENV}"
    exit 3
fi
# shellcheck disable=SC1091
source "${SFNO_VENV}/bin/activate"
export PYTHONNOUSERSITE=1
export PYTHONPATH="${MAKANI_ROOT}/src:${PYTHONPATH:-}"
export HDF5_USE_FILE_LOCKING=FALSE
export CUDA_VISIBLE_DEVICES=""

[ -n "${NC_DIR:-}" ] || { echo "ERROR READOUT_NO_NC_DIR"; exit 3; }
"${SFNO_VENV}/bin/python" "${MAKANI_ROOT}/polaris/climate_smoke_readout.py" "${NC_DIR}"/member_*.nc

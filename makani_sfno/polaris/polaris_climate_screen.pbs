#!/bin/bash -l
#PBS -N makani_climate_screen
#PBS -A lighthouse-uchicago
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -r n
#PBS -j oe
# ============================================================================
# Stage-0 stability screen (polaris_makani_finetune_stability_handoff.md §2).
# Sibling of polaris_climate_run.pbs: ONE fixed rollout per checkpoint, from
# START (default 2044 frame 1092 = Oct 1) for N_LEADS (default 1460 = one year;
# crosses 2044->2045 at lead 368), chunk 40. Four at a time, one per GPU.
#
# Checkpoints: CKPT_LIST file (default polaris/climate_screen_stage0.list), or
# CKPTS="label=run_dir:ckpt ..." (overrides the file). run_dir relative to
# $EXPROOT, ckpt relative to <run_dir>/training_checkpoints; absolute paths ok.
#
# Truth: TRUTH npz (default $MEMBER_ROOT/runs/makani_eval/screen_truth_<Y>f<F>.npz)
# is built on this node if missing, in parallel with the first rollouts.
#
# Resumable: pass OUT_ROOT=<a previous screen dir> and members whose .nc exists
# are skipped. New rounds stop launching once WALL_BUDGET_S has elapsed, so
# the summary always runs inside the walltime.
#
# Ranking + metrics are pre-registered in docs/2026-09-24_climate_screen_prereg.md.
# PASS = CLIMATE_SCREEN_OK n=<checkpoints> (every listed member OK/TRUNCATED,
# summary clean). A truncated member is a measurement, not a failure.
#
# Submit from makani_sfno/:   qsub polaris/polaris_climate_screen.pbs
#   second start (§2b re-screen): qsub -v START_FRAME=1156,CKPT_LIST=<top-3 file> ...
# ============================================================================

cd "${PBS_O_WORKDIR}" || exit 2
MAKANI_ROOT="$(cd "${PBS_O_WORKDIR}" && pwd)"
if [ ! -d "${MAKANI_ROOT}/src/sfno_inference" ]; then
    MAKANI_ROOT="$(cd "${PBS_O_WORKDIR}/.." && pwd)"
fi
REPO="$(cd "${MAKANI_ROOT}/.." && pwd)"

# Env bootstrap copied verbatim from polaris_climate_run.pbs (itself from
# polaris_eval_inference.pbs) -- module ordering differs per model on purpose.
# shellcheck disable=SC1091
source "${REPO}/polaris_env.sh" || exit 2
# shellcheck disable=SC1091
source "${MAKANI_ROOT}/polaris/polaris_makani_env.sh" || exit 2

if [ ! -x "${SFNO_VENV}/bin/python" ]; then
    echo "ERROR SFNO_VENV_MISSING: ${SFNO_VENV}"
    exit 3
fi
# shellcheck disable=SC1091
source "${SFNO_VENV}/bin/activate"
export PYTHONNOUSERSITE=1
export PYTHONPATH="${MAKANI_ROOT}/src:${PYTHONPATH:-}"
export HDF5_USE_FILE_LOCKING=FALSE
PY="${SFNO_VENV}/bin/python"

MEMBER_ROOT="${MEMBER_ROOT:-/eagle/projects/lighthouse-uchicago/members/mehta5}"
EXPROOT="${EXPROOT:-${MEMBER_ROOT}/runs/makani_mn_scaling/e3sm_mn_scaling}"
PACK="${PACK:-${MEMBER_ROOT}/data/e3sm_makani_alldata_production}"
START_YEAR="${START_YEAR:-2044}"
START_FRAME="${START_FRAME:-1092}"
N_LEADS="${N_LEADS:-1460}"
CHUNK_LEN="${CHUNK_LEN:-40}"
# DRY_AIR_FIX=config|on|off -> climate_rollout.py --dry-air-fix (DIAGNOSTIC mass fix;
# "on" applies it post hoc to checkpoints trained without it).
DRY_AIR_FIX="${DRY_AIR_FIX:-config}"
WALL_BUDGET_S="${WALL_BUDGET_S:-2880}"          # stop launching rounds after 48 min
CKPT_LIST="${CKPT_LIST:-${MAKANI_ROOT}/polaris/climate_screen_stage0.list}"
TRUTH="${TRUTH:-${MEMBER_ROOT}/runs/makani_eval/screen_truth_${START_YEAR}f${START_FRAME}.npz}"
JOB="${PBS_JOBID%%.*}"
OUT_ROOT="${OUT_ROOT:-${MEMBER_ROOT}/runs/makani_eval/climate_screen_${JOB}}"
SHA="$(cd "${REPO}" && git rev-parse --short=12 HEAD 2>/dev/null || echo unknown)"
mkdir -p "${OUT_ROOT}"
T0=$(date +%s)

if [ -n "${CKPTS:-}" ]; then
    read -r -a ENTRIES <<< "${CKPTS}"
else
    mapfile -t ENTRIES < <(sed -e 's/#.*//' -e 's/[[:space:]]*$//' "${CKPT_LIST}" | awk 'NF')
fi

echo "=== makani_climate_screen: $(date -Iseconds) ==="
echo "host=$(hostname)  PBS_JOBID=${PBS_JOBID}  sha=${SHA}  start=${START_YEAR}f${START_FRAME}  leads=${N_LEADS}  dry_air_fix=${DRY_AIR_FIX}  n=${#ENTRIES[@]}  out=${OUT_ROOT}"
echo "list=${CKPTS:+CKPTS env}${CKPTS:-${CKPT_LIST}}  truth=${TRUTH}"
makani_env_report
echo

# Resolve every entry up front; a bad path fails the screen before any GPU time.
declare -A RUN_OF CKPT_OF
LABELS=()
ok=1
for e in "${ENTRIES[@]}"; do
    label="${e%%=*}"; rest="${e#*=}"; run="${rest%%:*}"; ck="${rest#*:}"
    [[ "${run}" = /* ]] || run="${EXPROOT}/${run}"
    [[ "${ck}" = /* ]] || ck="${run}/training_checkpoints/${ck}"
    if [ -z "${label}" ] || [ "${label}" = "${e}" ] || [ ! -f "${run}/config.json" ] || [ ! -f "${ck}" ]; then
        echo "ERROR CLIMATE_SCREEN_BAD_ENTRY '${e}' (run=${run} ckpt=${ck})"; ok=0; continue
    fi
    RUN_OF[$label]="${run}"; CKPT_OF[$label]="${ck}"; LABELS+=("${label}")
done
[ "${ok}" -eq 1 ] || { echo "=== makani_climate_screen aborted: bad list ==="; exit 4; }

# Truth series: CPU, in the background while the first round rolls.
TRUTH_PID=""
if [ ! -f "${TRUTH}" ]; then
    CUDA_VISIBLE_DEVICES="" OMP_NUM_THREADS=4 "${PY}" "${MAKANI_ROOT}/polaris/climate_screen_summary.py" truth \
        --pack "${PACK}" --start "${START_YEAR}" "${START_FRAME}" --n-leads "${N_LEADS}" \
        --out "${TRUTH}" > "${OUT_ROOT}/truth.log" 2>&1 &
    TRUTH_PID=$!
    echo "truth: building ${TRUTH} pid=${TRUTH_PID}"
else
    echo "truth: reusing ${TRUTH}"
fi

skipped=0
launched=0
# Launched inline, NOT via $(function): a command substitution runs in a subshell,
# the member would not be this shell's child, and `wait` could not see it.
for ((t = 0; t < ${#LABELS[@]}; t += 4)); do
    if [ $(( $(date +%s) - T0 )) -gt "${WALL_BUDGET_S}" ]; then
        echo "WALL_BUDGET reached after ${launched} launched; remaining members left for a resume (OUT_ROOT=${OUT_ROOT})"
        break
    fi
    declare -A PIDS=()
    g=0
    for ((j = t; j < t + 4 && j < ${#LABELS[@]}; j++)); do
        label="${LABELS[$j]}"
        if [ -f "${OUT_ROOT}/screen_${label}.nc" ]; then
            echo "skip ${label}: screen_${label}.nc exists"; skipped=$((skipped + 1)); continue
        fi
        CUDA_VISIBLE_DEVICES="${g}" "${PY}" -m torch.distributed.run --standalone \
            --nproc_per_node=1 "${MAKANI_ROOT}/scripts/climate_rollout.py" \
            --run-dir "${RUN_OF[$label]}" --ckpt "${CKPT_OF[$label]}" \
            --start "${START_YEAR}" "${START_FRAME}" --n-steps "${N_LEADS}" \
            --member-id "${label}" --chunk-len "${CHUNK_LEN}" --dry-air-fix "${DRY_AIR_FIX}" \
            --years-dir "${OUT_ROOT}/years/${label}" \
            --out "${OUT_ROOT}/screen_${label}.nc" --git-sha "${SHA}" \
            > "${OUT_ROOT}/screen_${label}.log" 2>&1 &
        PIDS[$label]=$!
        launched=$((launched + 1))
        echo "launched ${label} gpu=${g} pid=${PIDS[$label]} ckpt=${CKPT_OF[$label]##*/} ($(date +%T))"
        g=$((g + 1))
    done
    for label in $(printf '%s\n' "${!PIDS[@]}" | sort); do
        wait "${PIDS[$label]}"
        rc=$?
        log="${OUT_ROOT}/screen_${label}.log"
        line=$(grep -E "^(CLIMATE_ROLLOUT_(OK|TRUNCATED)|ERROR)" "${log}" | tail -1)
        perf=$(grep -E "^PERF" "${log}" | tail -1)
        echo "  ${label} rc=${rc} ${perf} :: ${line}"
        if ! grep -qE "^CLIMATE_ROLLOUT_(OK|TRUNCATED)" "${log}" || [ ! -f "${OUT_ROOT}/screen_${label}.nc" ]; then
            echo "ERROR CLIMATE_SCREEN_MEMBER_FAILED ${label} (see ${log})"; ok=0
        fi
    done
    unset PIDS
done

if [ -n "${TRUTH_PID}" ]; then
    wait "${TRUTH_PID}"
    cat "${OUT_ROOT}/truth.log" | tail -5
    grep -q "^CLIMATE_SCREEN_TRUTH_OK" "${OUT_ROOT}/truth.log" || { echo "ERROR CLIMATE_SCREEN_TRUTH_FAILED (see ${OUT_ROOT}/truth.log)"; ok=0; }
fi

NCS=()
missing=()
for label in "${LABELS[@]}"; do
    if [ -f "${OUT_ROOT}/screen_${label}.nc" ]; then NCS+=("${OUT_ROOT}/screen_${label}.nc"); else missing+=("${label}"); fi
done
echo "--- summary ($(date -Iseconds)): ${#NCS[@]} of ${#LABELS[@]} members present; skipped(existing)=${skipped} launched=${launched} ---"
[ "${#missing[@]}" -eq 0 ] || { echo "ERROR CLIMATE_SCREEN_INCOMPLETE missing: ${missing[*]}"; ok=0; }
sum_ok=0
if [ -f "${TRUTH}" ] && [ "${#NCS[@]}" -gt 0 ]; then
    CUDA_VISIBLE_DEVICES="" "${PY}" "${MAKANI_ROOT}/polaris/climate_screen_summary.py" summarize \
        --truth "${TRUTH}" --n-leads "${N_LEADS}" \
        --csv "${OUT_ROOT}/screen_summary.csv" --md "${OUT_ROOT}/screen_summary.md" \
        "${NCS[@]}" > "${OUT_ROOT}/summary.log" 2>&1
    cat "${OUT_ROOT}/summary.log"
    grep -q "^CLIMATE_SCREEN_SUMMARY_OK" "${OUT_ROOT}/summary.log" && sum_ok=1
fi
[ "${sum_ok}" -eq 1 ] || ok=0

[ "${ok}" -eq 1 ] && echo "CLIMATE_SCREEN_OK n=${#NCS[@]} out=${OUT_ROOT}"
echo "=== makani_climate_screen done $(date -Iseconds) ==="

#!/bin/bash -l
#PBS -N makani_score_k56
#PBS -A lighthouse-uchicago
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -r n
#PBS -j oe
# ============================================================================
# Score the K=56 rollout NetCDFs and apply the pre-registered read-out rule.
# Stage 2 of the eval chain, in the E3SM sibling form (CLAUDE.md #7) --
# polaris_eval_inference.pbs ported stage 1 and deliberately not this one,
# because scripts/score_nwp.py is the PLaSim scorer: Gauss-Legendre quadrature
# (1.50x over-weighting of the polar row on our equiangular pack, change G), a
# calendar-binned climatology E3SM has no builder for, and a `tas`/`zg500`
# sanity gate.  polaris/score_rollout_nc.py is the replacement; it reuses
# sfno_eval.metrics for the formulas so only the quadrature and climatology
# differ from the PLaSim track.
#
# WHAT IT DECIDES.  Job 7633207 wrote 24 ICs x 56 leads on 2026-09-19 and
# nothing has read them.  That curve is the gate between the CRPS arm (changes
# the loss => jesswan's sign-off) and n_future=8 (memory audit first).  The rule
# is fixed in docs/2026-09-20_k56_readout_prereg.md §3, written BEFORE any
# number was computed, and lives in code as classify_regime().
#
# WHAT ELSE IT PRODUCES.  k56_metrics.h5 carries RMSE over all 56 depths --
# sigma(k) for the lagged ensemble's weighted combination (w_k ~ 1/sigma(k)^2,
# end-to-end plan task 13), which today has no weights past lead 20.
#
# CPU-ONLY ON PURPOSE.  The work is 45 GB of zlib decompression plus reductions;
# a GPU would add allocator noise and no speed.  Same reasoning as
# polaris_e3sm_port_test.pbs.
#
# Knobs (-v):
#   RUN         eval run dir name under runs/makani_eval  (default prod1n_b32_sgdr_K56)
#   NC_DIR      override the NetCDF directory             (default <RUN>/inference/nwp)
#   TIME_MEANS  pack climatology .npy                     (default production pack stats)
#   OUT_DIR     where the three outputs go                (default <RUN>/scores)
#   SMOKE=1     score 2 ICs only -- exercises the path, NOT a verdict
#
# PASS = K56_SCORE_TESTS_OK then K56_SCORE_OK.  Per CLAUDE.md #14 neither rc is
# the signal: a sweep too short to reach the 336 h anchor writes curves, exits
# without a verdict, and must not read as a decision.
#
# Submit from makani_sfno/:
#   qsub -v SMOKE=1 polaris/polaris_score_k56.pbs
#   qsub polaris/polaris_score_k56.pbs
# ============================================================================

cd "${PBS_O_WORKDIR}" || exit 2
MAKANI_ROOT="$(cd "${PBS_O_WORKDIR}" && pwd)"
if [ ! -d "${MAKANI_ROOT}/src/sfno_eval" ]; then
    MAKANI_ROOT="$(cd "${PBS_O_WORKDIR}/.." && pwd)"
fi
if [ ! -d "${MAKANI_ROOT}/src/sfno_eval" ]; then
    echo "ERROR MAKANI_ROOT_NOT_FOUND: PBS_O_WORKDIR=${PBS_O_WORKDIR} derived=${MAKANI_ROOT}"
    exit 2
fi
REPO="$(cd "${MAKANI_ROOT}/.." && pwd)"

# Env bootstrap copied verbatim from polaris_eval_inference.pbs -- module
# ordering differs per model on purpose (CLAUDE.md, "Writing a new submission
# script").
# shellcheck disable=SC1091
source "${REPO}/polaris_env.sh" || exit 2
# shellcheck disable=SC1091
source "${MAKANI_ROOT}/polaris/polaris_makani_env.sh" || exit 2

if [ ! -x "${SFNO_VENV}/bin/python" ]; then
    echo "ERROR SFNO_VENV_MISSING: ${SFNO_VENV}"
    exit 3
fi
# shellcheck disable=SC1091
source "${SFNO_VENV}/bin/activate"
# A --system-site-packages venv re-enables the USER site, which site.py ranks
# ABOVE the venv.
export PYTHONNOUSERSITE=1
export PYTHONPATH="${MAKANI_ROOT}/src:${PYTHONPATH:-}"
export HDF5_USE_FILE_LOCKING=FALSE
export CUDA_VISIBLE_DEVICES=""
PY="${SFNO_VENV}/bin/python"

MEMBER_ROOT="${MEMBER_ROOT:-/eagle/projects/lighthouse-uchicago/members/mehta5}"
RUN="${RUN:-prod1n_b32_sgdr_K56}"
EVAL_ROOT="${MEMBER_ROOT}/runs/makani_eval/${RUN}"
NC_DIR="${NC_DIR:-${EVAL_ROOT}/inference/nwp}"
# A smoke writes somewhere else by default. Sharing the output directory would let
# a 2-IC run silently replace a 24-IC result with three files of the same names --
# a non-result that reads exactly like a result (CLAUDE.md #14).
if [ "${SMOKE:-0}" = "1" ]; then
    OUT_DIR="${OUT_DIR:-${EVAL_ROOT}/scores_smoke}"
else
    OUT_DIR="${OUT_DIR:-${EVAL_ROOT}/scores}"
fi
TIME_MEANS="${TIME_MEANS:-${MEMBER_ROOT}/data/e3sm_makani_alldata_production/stats/time_means.npy}"

for _p in "${NC_DIR}" "${TIME_MEANS}"; do
    if [ ! -e "${_p}" ]; then
        echo "ERROR SCORE_INPUT_MISSING: ${_p}"
        exit 3
    fi
done

echo "=== makani_score_k56: $(date -Iseconds) ==="
echo "host=$(hostname)  PBS_JOBID=${PBS_JOBID}"
echo "nc_dir=${NC_DIR}"
echo "clim=${TIME_MEANS}"
echo "out_dir=${OUT_DIR}  smoke=${SMOKE:-0}"
makani_env_report
echo

# The rule is only pre-registered if the code that applies it is the code that
# was tested: run the branch tests in the same job, before any number is read.
"${PY}" -m pytest -q "${MAKANI_ROOT}/polaris/test_score_rollout_nc.py" -p no:cacheprovider
rc=$?
echo "--- pytest rc=${rc} ---"
if [ ${rc} -ne 0 ]; then
    echo "ERROR K56_SCORE_TESTS_FAILED rc=${rc}"
    exit 4
fi
echo "K56_SCORE_TESTS_OK"
echo

EXTRA=()
if [ "${SMOKE:-0}" = "1" ]; then
    # Two ICs still reach 336 h, so the path is exercised end to end -- but the
    # verdict from 2 of 24 ICs is not the measurement. Read the token, not the
    # branch, on a smoke.
    EXTRA+=(--limit-files 2)
fi

SHA7="$(cd "${REPO}" && git rev-parse --short=7 HEAD 2>/dev/null || echo unknown)"

set -x
"${PY}" "${MAKANI_ROOT}/polaris/score_rollout_nc.py" \
    --nc-dir "${NC_DIR}" \
    --time-means "${TIME_MEANS}" \
    --out-dir "${OUT_DIR}" \
    --grid-type equiangular \
    --provenance "job=${PBS_JOBID%%.*} sha=${SHA7} run=${RUN}" \
    "${EXTRA[@]}"
rc=$?
set +x

echo "--- score_rollout_nc rc=${rc} ---"
if [ ${rc} -ne 0 ]; then
    echo "ERROR K56_SCORE_FAILED rc=${rc}"
    exit 5
fi

# rc=0 is not the pass signal (CLAUDE.md #14): confirm the three artefacts exist.
for _f in k56_metrics.h5 k56_summary.csv k56_readout.json; do
    if [ ! -s "${OUT_DIR}/${_f}" ]; then
        echo "ERROR K56_SCORE_NO_OUTPUT: ${OUT_DIR}/${_f} missing or empty"
        exit 6
    fi
done

echo "=== makani_score_k56 done $(date -Iseconds) ==="

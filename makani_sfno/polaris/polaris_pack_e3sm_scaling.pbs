#!/bin/bash -l
#PBS -N makani_pack_scaling
#PBS -A lighthouse-uchicago
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -r n
#PBS -j oe
# ============================================================================
# Pack a few full years of E3SM, locked 52-channel set (convert_e3sm_to_makani.py),
# for the multi-node scaling sweep.
#
# The sweep first used the smoke pack ($MEMBER_ROOT/data/e3sm_makani), which holds
# only 400 samples per year. Arms B and C need 480 and 960 samples, and the sweep
# refused them (ERROR NOT_ENOUGH_SAMPLES: 400 < 960). This job packs whole years,
# 1460 samples each.
#
# Default: 2 train years + 1 valid + 1 test, which fits the 1-hour debug limit at
# about 6 minutes and 22 GB per year. Knobs:
#   -v TRAIN_FROM=2015 -v TRAIN_TO=2016     train years, inclusive
#   -v VALID_YEAR=2017 -v TEST_YEAR=2018
#   -v PACK_NAME=e3sm_makani_scaling        output directory under $MEMBER_ROOT/data
# It will not write into an existing directory. The smoke pack is the data behind
# the green run 7253465 and arm A (7553836), and stays as it is.
#
# PASS = CONVERT_OK and PACK_SCALING_OK; rc=0 alone is not.
# ============================================================================

cd "${PBS_O_WORKDIR}" || exit 2
MAKANI_ROOT="$(cd "${PBS_O_WORKDIR}" && pwd)"
if [ ! -d "${MAKANI_ROOT}/src/sfno_training" ]; then
    MAKANI_ROOT="$(cd "${PBS_O_WORKDIR}/.." && pwd)"
fi
REPO="$(cd "${MAKANI_ROOT}/.." && pwd)"

# polaris_env.sh first: it defines MEMBER_ROOT, which polaris_makani_env.sh needs.
# shellcheck disable=SC1091
source "${REPO}/polaris_env.sh" || exit 2
# shellcheck disable=SC1091
source "${MAKANI_ROOT}/polaris/polaris_makani_env.sh" || exit 2
# shellcheck disable=SC1091
source "${SFNO_VENV}/bin/activate" || exit 2
export PYTHONNOUSERSITE=1
PY="${SFNO_VENV}/bin/python"

TRAIN_FROM="${TRAIN_FROM:-2015}"
TRAIN_TO="${TRAIN_TO:-2016}"
VALID_YEAR="${VALID_YEAR:-2017}"
TEST_YEAR="${TEST_YEAR:-2018}"
OUT="${MEMBER_ROOT}/data/${PACK_NAME:-e3sm_makani_scaling}"

echo "=== makani_pack_scaling: $(date -Iseconds) on $(hostname), job ${PBS_JOBID%%.*} ==="
polaris_env_report
makani_env_report
echo "out ${OUT}  train ${TRAIN_FROM}-${TRAIN_TO}  valid ${VALID_YEAR}  test ${TEST_YEAR}"
df -h /eagle 2>/dev/null | tail -1

if [ ! -d "${E3SM_ROOT}/h5/plev_data" ]; then
    echo "ERROR E3SM_SOURCE_MISSING: ${E3SM_ROOT}/h5/plev_data"
    exit 2
fi
if [ -e "${OUT}" ]; then
    echo "ERROR PACK_EXISTS: ${OUT}"
    echo "  Pick another -v PACK_NAME=, or remove it yourself. A half-rewritten pack is"
    echo "  worse than none: the sweep cannot tell them apart by sample count."
    exit 2
fi

# No --max-samples-per-year: that flag is what made the smoke pack too small.
time "${PY}" "${MAKANI_ROOT}/polaris/convert_e3sm_to_makani.py" \
    --e3sm-root   "${E3SM_ROOT}" \
    --output-root "${OUT}" \
    --train-years "${TRAIN_FROM}" "${TRAIN_TO}" \
    --valid-years "${VALID_YEAR}" "${VALID_YEAR}" \
    --test-years  "${TEST_YEAR}"  "${TEST_YEAR}" \
    --validate
rc=$?
[ ${rc} -eq 0 ] || { echo "ERROR PACK_SCALING_FAILED rc=${rc}"; exit ${rc}; }

# The sweep checks the number of train samples, not files, so report it.
"${PY}" - "${OUT}" <<'PY'
import glob, os, sys
import h5py
total = 0
for path in sorted(glob.glob(os.path.join(sys.argv[1], "train", "*.h5"))):
    with h5py.File(path, "r") as f:
        total += f["fields_state"].shape[0]
print("train samples total: %d" % total)
# 60 steps at 1 sample per GPU and 4 GPUs per node: nodes = total / 240.
print("supports 60 steps at global batch up to %d, i.e. %d nodes" % (total // 60, total // 240))
PY

echo "PACK_SCALING_OK ${OUT}"
echo "  Use it:  qsub -v PACK=${OUT} ... polaris/polaris_makani_multinode_scaling.pbs"
echo "=== done $(date -Iseconds) ==="

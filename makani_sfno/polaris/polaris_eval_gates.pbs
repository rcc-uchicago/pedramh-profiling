#!/bin/bash -l
#PBS -N makani_eval_gates
#PBS -A lighthouse-uchicago
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l filesystems=home:eagle
#PBS -l walltime=00:40:00
#PBS -r n
#PBS -j oe
# ============================================================================
# Infrastructure gates of docs/2026-10-09_pipeline_comparison_prereg.md §6
# (docs/makani-knowledge d06b4916), run before the existing-pool sweep:
#
#   EMA_EXTRACT_OK       scripts/extract_ema_ckpt.py rebuilds the EMA weights from a
#                        per-epoch ckpt bitwise-equal to the trainer's EMA-best file:
#                        F-scratch v21|v22|v23 vs best_ckpt_ema_mp0_e23_stable.tar and
#                        F-depth4 v0|v1 vs best_ckpt_ema_mp0_e1_stable.tar. Exactly
#                        one version must match per run (that is the version->epoch map).
#   AMP_OFF_DEFAULT_EQUIV_OK  climate_rollout.py with --amp left at its default
#                        reproduces member_FD2400.nc (7727731) global_mean bitwise
#                        over the first N_EQ steps.
#   AMP_OFF_SMOKE_OK     the same start with --amp off: finite, fp32 feedback logged.
#
# Read-only on every checkpoint. Outputs: $EVAL/eval_gates_<job>/.
# Submit from makani_sfno/:   qsub polaris/polaris_eval_gates.pbs
# PASS = EVAL_GATES_OK (all three tokens).
# ============================================================================

cd "${PBS_O_WORKDIR}" || exit 2
MAKANI_ROOT="$(cd "${PBS_O_WORKDIR}" && pwd)"
if [ ! -d "${MAKANI_ROOT}/src/sfno_inference" ]; then
    MAKANI_ROOT="$(cd "${PBS_O_WORKDIR}/.." && pwd)"
fi
REPO="$(cd "${MAKANI_ROOT}/.." && pwd)"

# Env bootstrap copied verbatim from polaris_climate_run.pbs.
# shellcheck disable=SC1091
source "${REPO}/polaris_env.sh" || exit 2
# shellcheck disable=SC1091
source "${MAKANI_ROOT}/polaris/polaris_makani_env.sh" || exit 2

if [ ! -x "${SFNO_VENV}/bin/python" ]; then
    echo "ERROR SFNO_VENV_MISSING: ${SFNO_VENV}"
    exit 3
fi
# shellcheck disable=SC1091
source "${SFNO_VENV}/bin/activate"
export PYTHONNOUSERSITE=1
export PYTHONPATH="${MAKANI_ROOT}/src:${PYTHONPATH:-}"
export HDF5_USE_FILE_LOCKING=FALSE
PY="${SFNO_VENV}/bin/python"

MEMBER_ROOT="${MEMBER_ROOT:-/eagle/projects/lighthouse-uchicago/members/mehta5}"
EXPROOT="${MEMBER_ROOT}/runs/makani_mn_scaling/e3sm_mn_scaling"
EVAL="${MEMBER_ROOT}/runs/makani_eval"
JOB="${PBS_JOBID%%.*}"
OUT="${EVAL}/eval_gates_${JOB}"
N_EQ="${N_EQ:-120}"
SHA="$(cd "${REPO}" && git rev-parse --short=12 HEAD 2>/dev/null || echo unknown)"
mkdir -p "${OUT}"
echo "=== makani_eval_gates: $(date -Iseconds) host=$(hostname) PBS_JOBID=${PBS_JOBID} sha=${SHA} ==="

FD=fsF_anneal_nf4_b16_rtmax100_scratch
FS=f_nosoil_2n_b32_e23_scratch
FD_CKPT="${EXPROOT}/${FD}/training_checkpoints/ckpt_mp0_v23.tar"
REF_NC="${EVAL}/climate_protocol_7727731/member_FD2400.nc"

# --- rollouts on two GPUs, in the background: default (bitwise) and --amp off --------
for arm in default ampoff; do
    extra=""; gpu=0
    [ "${arm}" = "ampoff" ] && { extra="--amp off"; gpu=1; }
    # shellcheck disable=SC2086
    CUDA_VISIBLE_DEVICES="${gpu}" "${PY}" -m torch.distributed.run --standalone --nproc_per_node=1 \
        "${MAKANI_ROOT}/scripts/climate_rollout.py" \
        --run-dir "${EXPROOT}/${FD}" --ckpt "${FD_CKPT}" \
        --start 2044 1092 --n-steps "${N_EQ}" --score-start 2045 0 \
        --member-id "eq_${arm}" --chunk-len 40 --snapshot-every 0 \
        --years-dir "${OUT}/years/${arm}" --out "${OUT}/eq_${arm}.nc" --git-sha "${SHA}" ${extra} \
        > "${OUT}/eq_${arm}.log" 2>&1 &
    eval "PID_${arm}=$!"
done

# --- EMA extraction gate on the CPU while the GPUs roll --------------------------------
ema_ok=1
check_run() {   # <label> <run> <ref file> <versions...>
    local label="$1" run="$2" ref="$3"; shift 3
    local d="${EXPROOT}/${run}/training_checkpoints" n=0 v
    for v in "$@"; do
        echo "--- ${label}: ckpt_mp0_v${v}.tar vs ${ref}"
        if CUDA_VISIBLE_DEVICES="" "${PY}" "${MAKANI_ROOT}/scripts/extract_ema_ckpt.py" \
               --ckpt "${d}/ckpt_mp0_v${v}.tar" --check-against "${d}/${ref}"; then
            n=$((n + 1)); echo "MAP ${label} v${v} == ${ref}"
        fi
    done
    [ "${n}" -eq 1 ] || { echo "ERROR EMA_EXTRACT_MATCHES=${n} ${label} (need exactly 1)"; ema_ok=0; }
}
check_run F-scratch "${FS}" best_ckpt_ema_mp0_e23_stable.tar 21 22 23
check_run F-depth4 "${FD}" best_ckpt_ema_mp0_e1_stable.tar 0 1
[ "${ema_ok}" -eq 1 ] && echo "EMA_EXTRACT_OK"

wait "${PID_default}"; wait "${PID_ampoff}"
for arm in default ampoff; do echo "--- eq_${arm}.log"; grep -E "^(member=|PERF|CLIMATE_ROLLOUT|ERROR)" "${OUT}/eq_${arm}.log"; done

CUDA_VISIBLE_DEVICES="" "${PY}" - "${OUT}" "${REF_NC}" "${N_EQ}" > "${OUT}/amp_gates.txt" 2>&1 <<'PY'
import sys
import numpy as np
import netCDF4
out, ref_nc, n = sys.argv[1], sys.argv[2], int(sys.argv[3])
def gm(p):
    with netCDF4.Dataset(p) as ds:
        return np.asarray(ds["global_mean"][:n], dtype=np.float64), [str(c) for c in ds["channel"][:]]
ref, ch = gm(ref_nc)
dflt, ch2 = gm(f"{out}/eq_default.nc")
assert ch == ch2, "channel lists differ"
if dflt.shape == ref.shape and np.array_equal(dflt, ref):
    print(f"AMP_OFF_DEFAULT_EQUIV_OK steps={n} channels={len(ch)} (bitwise vs {ref_nc})")
else:
    d = np.abs(dflt - ref); i = np.unravel_index(np.nanargmax(d), d.shape)
    print(f"ERROR AMP_DEFAULT_NOT_BITWISE max|diff|={np.nanmax(d):.3e} at step {i[0]+1} {ch[i[1]]}")
off, _ = gm(f"{out}/eq_ampoff.nc")
log = open(f"{out}/eq_ampoff.log").read()
fin = np.isfinite(off).all() and off.shape == ref.shape
fp32 = "feedback_dtype=torch.float32" in log and "amp=off" in log
if fin and fp32:
    rel = np.abs(off[-1] - ref[-1]) / (np.abs(ref[-1]) + 1e-30)
    k = int(np.argmax(rel))
    print(f"AMP_OFF_SMOKE_OK steps={n} finite fp32-feedback; step-{n} global-mean rel diff vs bf16: "
          f"median {np.median(rel):.2e}, max {rel[k]:.2e} ({ch[k]})")
else:
    print(f"ERROR AMP_OFF_SMOKE finite={fin} fp32_logged={fp32}")
PY

cat "${OUT}/amp_gates.txt"
if [ "${ema_ok}" -eq 1 ] && grep -q "^AMP_OFF_DEFAULT_EQUIV_OK" "${OUT}/amp_gates.txt" \
        && grep -q "^AMP_OFF_SMOKE_OK" "${OUT}/amp_gates.txt"; then
    echo "EVAL_GATES_OK out=${OUT}"
fi
echo "=== makani_eval_gates done $(date -Iseconds) ==="

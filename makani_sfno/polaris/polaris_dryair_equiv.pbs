#!/bin/bash -l
#PBS -N makani_dryair_equiv
#PBS -A lighthouse-uchicago
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l filesystems=home:eagle
#PBS -l walltime=00:30:00
#PBS -r n
#PBS -j oe
# ============================================================================
# Flag-off equivalence gate for the dry-air fix (CLAUDE.md #1/#6): with
# conserve_dry_air off, the code on this branch must roll out BITWISE the same
# as the code before the fix existed.
#
# Same node, same GPUs model, two code trees:
#   REF  = REF_TREE (default: the finetune-stability worktree, pinned by its sha,
#          which has no fix) -- its own src/ and scripts/climate_rollout.py
#   NEW  = this tree, --dry-air-fix off
# for each of B_e22 (survives the year) and A_e243 (truncates at lead 595), 1460
# leads from 2044 f1092; every numeric variable of the member NetCDFs compared
# bitwise (compare_member_nc.py). Four rollouts, one per GPU, in parallel.
#
# PASS = DRYAIR_OFF_EQUIV_OK (both pairs MEMBER_NC_EQUIV_OK).
# Submit from makani_sfno/:   qsub polaris/polaris_dryair_equiv.pbs
# ============================================================================

cd "${PBS_O_WORKDIR}" || exit 2
MAKANI_ROOT="$(cd "${PBS_O_WORKDIR}" && pwd)"
if [ ! -d "${MAKANI_ROOT}/src/sfno_inference" ]; then
    MAKANI_ROOT="$(cd "${PBS_O_WORKDIR}/.." && pwd)"
fi
REPO="$(cd "${MAKANI_ROOT}/.." && pwd)"

# Env bootstrap copied verbatim from polaris_climate_screen.pbs.
# shellcheck disable=SC1091
source "${REPO}/polaris_env.sh" || exit 2
# shellcheck disable=SC1091
source "${MAKANI_ROOT}/polaris/polaris_makani_env.sh" || exit 2

if [ ! -x "${SFNO_VENV}/bin/python" ]; then
    echo "ERROR SFNO_VENV_MISSING: ${SFNO_VENV}"
    exit 3
fi
# shellcheck disable=SC1091
source "${SFNO_VENV}/bin/activate"
export PYTHONNOUSERSITE=1
export HDF5_USE_FILE_LOCKING=FALSE
PY="${SFNO_VENV}/bin/python"
BASE_PYTHONPATH="${PYTHONPATH:-}"

MEMBER_ROOT="${MEMBER_ROOT:-/eagle/projects/lighthouse-uchicago/members/mehta5}"
EXPROOT="${MEMBER_ROOT}/runs/makani_mn_scaling/e3sm_mn_scaling"
REF_TREE="${REF_TREE:-${REPO}/../finetune-stability/makani_sfno}"
REF_TREE="$(cd "${REF_TREE}" && pwd)"
REF_SHA="$(cd "${REF_TREE}/.." && git rev-parse --short=12 HEAD 2>/dev/null)"
NEW_SHA="$(cd "${REPO}" && git rev-parse --short=12 HEAD 2>/dev/null)"
JOB="${PBS_JOBID%%.*}"
OUT="${MEMBER_ROOT}/runs/makani_eval/dryair_equiv_${JOB}"
mkdir -p "${OUT}"

echo "=== makani_dryair_equiv: $(date -Iseconds) host=$(hostname) PBS_JOBID=${PBS_JOBID} ==="
echo "REF tree=${REF_TREE} sha=${REF_SHA}"
echo "NEW tree=${MAKANI_ROOT} sha=${NEW_SHA}"
if [ -f "${REF_TREE}/src/sfno_training/models/mass_fix.py" ]; then
    echo "ERROR REF_TREE_HAS_FIX: ${REF_TREE} already contains mass_fix.py; not a pre-fix reference"
    exit 4
fi

declare -A CK=([B_e22]="nf4_prod_b16_r1:ckpt_mp0_v1.tar" [A_e243]="prod1n_b32_sgdr:ckpt_mp0_v242.tar")
declare -A PIDS=()
g=0
for m in B_e22 A_e243; do
    run="${EXPROOT}/${CK[$m]%%:*}"; ck="${run}/training_checkpoints/${CK[$m]#*:}"
    for side in ref new; do
        if [ "${side}" = ref ]; then tree="${REF_TREE}"; extra=(); else tree="${MAKANI_ROOT}"; extra=(--dry-air-fix off); fi
        PYTHONPATH="${tree}/src:${BASE_PYTHONPATH}" CUDA_VISIBLE_DEVICES="${g}" \
            "${PY}" -m torch.distributed.run --standalone --nproc_per_node=1 \
            "${tree}/scripts/climate_rollout.py" --run-dir "${run}" --ckpt "${ck}" \
            --start 2044 1092 --n-steps 1460 --member-id "${m}_${side}" "${extra[@]}" \
            --years-dir "${OUT}/years/${m}_${side}" --out "${OUT}/${m}_${side}.nc" \
            > "${OUT}/${m}_${side}.log" 2>&1 &
        PIDS["${m}_${side}"]=$!
        echo "launched ${m}_${side} gpu=${g} tree=${tree}"
        g=$((g + 1))
    done
done
for k in $(printf '%s\n' "${!PIDS[@]}" | sort); do
    wait "${PIDS[$k]}"
    echo "  ${k} rc=$? :: $(grep -E '^(CLIMATE_ROLLOUT_(OK|TRUNCATED)|ERROR)' "${OUT}/${k}.log" | tail -1)"
done

ok=1
for m in B_e22 A_e243; do
    echo "--- ${m}: ref vs new (flag off)"
    CUDA_VISIBLE_DEVICES="" "${PY}" "${MAKANI_ROOT}/polaris/compare_member_nc.py" \
        "${OUT}/${m}_ref.nc" "${OUT}/${m}_new.nc" 2>&1 | tail -12 | tee "${OUT}/${m}_compare.log"
    grep -q "^MEMBER_NC_EQUIV_OK" "${OUT}/${m}_compare.log" || ok=0
done
[ "${ok}" -eq 1 ] && echo "DRYAIR_OFF_EQUIV_OK ref=${REF_SHA} new=${NEW_SHA}" || echo "ERROR DRYAIR_OFF_EQUIV_FAILED"
echo "=== makani_dryair_equiv done $(date -Iseconds) ==="

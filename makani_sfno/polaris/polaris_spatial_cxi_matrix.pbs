#!/bin/bash -l
#PBS -N makani_spatial_cxi
#PBS -A lighthouse-uchicago
#PBS -q debug
#PBS -l select=2:system=polaris
#PBS -l place=scatter
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -r n
#PBS -j oe
# ============================================================================
# Spatial parallelism on the FIXED CXI stack, phase 1 -- pre-registered in
# makani_sfno/docs/2026-09-29_spatial_cxi_prereg.md (read it; predictions P1-P5 there).
#
# 2 nodes / 8 A100, global batch 32, 4 sample-equivalents per GPU in EVERY arm, knobs
# identical to the TCP-era matrix (submit_when_slot_frees.sh COMMON: STEPS=60, EPOCHS=2,
# e3sm_alldata_full.yaml, production pack) except: EVAL_SAMPLES=32 and NO fabric pins
# (the launcher default is the fixed stack: v1.6.0 + Simple + HPE rendezvous block).
#
#   arm    data groups  LOCAL_BATCH  spatial group
#   h1w1   8            4            -             <- the 2-node CXI number F/G need
#   h2w2   2            16           4 (intra-node)
#   h4w1   2            16           4 (intra-node)
#   h2w4   1            32           8 (both nodes) <- sec. 5b predicts a hang; runs LAST
#
# Each arm runs the production harness in this allocation with a hard timeout; a
# timed-out arm ENDS the matrix (its ranks may still hold the GPUs). Flight recorder on.
# PASS tokens: SPATIAL_CXI_ARM_OK / _HANG / _FAILED per arm, then
# SPATIAL_CXI_MATRIX_DONE <ok>/<run> with the step table. Rows -> bench/makani_spatial_cxi.csv.
# Submit from makani_sfno/:   qsub polaris/polaris_spatial_cxi_matrix.pbs
# ============================================================================
set -u
cd "${PBS_O_WORKDIR}" || exit 2
MAKANI_ROOT="$(cd "${PBS_O_WORKDIR}" && pwd)"
[ -d "${MAKANI_ROOT}/src/sfno_training" ] || { echo "ERROR MAKANI_ROOT_NOT_FOUND: submit from makani_sfno/"; exit 2; }
REPO="$(cd "${MAKANI_ROOT}/.." && pwd)"
JOBID="${PBS_JOBID%%.*}"

# ---- environment (verbatim from polaris_makani_ports_smoke.pbs) ---------------
# shellcheck disable=SC1091
source "${REPO}/polaris_env.sh" || exit 2
# shellcheck disable=SC1091
source "${MAKANI_ROOT}/polaris/polaris_makani_env.sh" || exit 2

if [ ! -x "${SFNO_VENV}/bin/python" ]; then
    echo "ERROR SFNO_VENV_MISSING: ${SFNO_VENV}"
    exit 3
fi
# shellcheck disable=SC1091
source "${SFNO_VENV}/bin/activate"
export PYTHONNOUSERSITE=1
PY="${SFNO_VENV}/bin/python"
export PYTHONPATH="${MAKANI_ROOT}/src:${PYTHONPATH:-}"
export WANDB_MODE="${WANDB_MODE:-offline}"
export HDF5_USE_FILE_LOCKING=FALSE
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# -----------------------------------------------------------------------------

CSV="${MEMBER_ROOT}/bench/makani_spatial_cxi.csv"
TRACE="${MEMBER_ROOT}/runs/makani_mn_scaling/nccl_trace"
OUT="${MEMBER_ROOT}/runs/makani_probe/spatial_cxi/${JOBID}"
ARM_TIMEOUT="${ARM_TIMEOUT:-780}"
mkdir -p "${OUT}" "${TRACE}" || exit 2
echo "=== makani_spatial_cxi: $(date -Iseconds) job=${JOBID} sha=$(cd "${REPO}" && git rev-parse --short=12 HEAD 2>/dev/null) ==="
echo "nodes: $(sort -u "${PBS_NODEFILE}" | paste -sd' ')  arm_timeout=${ARM_TIMEOUT}s  csv=${CSV}"

declare -a ORDER=(h1w1 h2w2 h4w1 h2w4)
declare -A HP=([h1w1]=1 [h2w2]=2 [h4w1]=4 [h2w4]=2)
declare -A WP=([h1w1]=1 [h2w2]=2 [h4w1]=1 [h2w4]=4)
declare -A LB=([h1w1]=4 [h2w2]=16 [h4w1]=16 [h2w4]=32)
declare -A RES
n_run=0; n_ok=0
for arm in "${ORDER[@]}"; do
    n_run=$((n_run + 1))
    echo "=== arm ${arm}: HPAR=${HP[$arm]} WPAR=${WP[$arm]} LOCAL_BATCH=${LB[$arm]} ==="
    t0=$(date +%s)
    STEPS=60 EPOCHS=2 EVAL_SAMPLES=32 WANDB=0 \
    CONFIG_YAML=e3sm_alldata_full.yaml PACK="${MEMBER_ROOT}/data/e3sm_makani_alldata_production" \
    MAKANI_SCALING_CSV="${CSV}" HPAR="${HP[$arm]}" WPAR="${WP[$arm]}" LOCAL_BATCH="${LB[$arm]}" \
    REP="${arm}" \
    TORCH_NCCL_TRACE_BUFFER_SIZE=2000 TORCH_NCCL_ASYNC_ERROR_HANDLING=1 \
    TORCH_NCCL_HEARTBEAT_TIMEOUT_SEC=1800 \
    TORCH_NCCL_DEBUG_INFO_TEMP_FILE="${TRACE}/spatialcxi_${JOBID}_${arm}_rank_" \
        timeout -k 60 "${ARM_TIMEOUT}" \
        bash "${MAKANI_ROOT}/polaris/polaris_makani_multinode_scaling.pbs" > "${OUT}/${arm}.out" 2>&1
    rc=$?
    dt=$(( $(date +%s) - t0 ))
    grep -E "FABRIC_|MAKANI_MN_SCALING_|ERROR" "${OUT}/${arm}.out" | tail -4
    if [ "${rc}" -eq 124 ] || [ "${rc}" -eq 137 ]; then
        RES[$arm]="HANG"
        echo "SPATIAL_CXI_ARM_HANG ${arm} after ${dt}s (flight recorder: ${TRACE}/spatialcxi_${JOBID}_${arm}_rank_*)"
        echo "matrix stops here: a timed-out arm's ranks may still hold the GPUs"
        break
    fi
    if grep -q "MAKANI_MN_SCALING_OK" "${OUT}/${arm}.out" && grep -q "FABRIC_CXI_CONFIRMED" "${OUT}/${arm}.out"; then
        RES[$arm]="OK"; n_ok=$((n_ok + 1))
        echo "SPATIAL_CXI_ARM_OK ${arm} rc=${rc} wall=${dt}s"
    else
        RES[$arm]="FAILED"
        echo "SPATIAL_CXI_ARM_FAILED ${arm} rc=${rc} wall=${dt}s (see ${OUT}/${arm}.out)"
    fi
done

# ---- the step table (this job's CSV rows) + the pre-registered comparisons -----
"${PY}" - "${CSV}" "${JOBID}" <<'PY'
import csv, sys
path, job = sys.argv[1], sys.argv[2]
try:
    rows = [r for r in csv.DictReader(open(path)) if r.get("jobid") == job]
except OSError:
    rows = []
ms = {}
for r in rows:
    arm = "h%sw%s" % (r["h_par"], r["w_par"])
    ms[arm] = float(r["step_ms"]) if r.get("step_ms") else None
    print("  %-5s nodes=%s local=%s step_ms=%s provider=%s" % (
        arm, r["nodes"], r["local_batch"], r["step_ms"], r.get("provider")))
b = ms.get("h1w1")
if b:
    print("  P1 h1w1 vs TCP 2-node 627.1 ms: %.1f ms (%+.1f %%)" % (b, 100 * (b / 627.1 - 1)))
    print("  P2 h1w1 vs 1-node 365.4 ms: %s; per-GPU efficiency vs 1 node = %.1f %%" % (
        "FASTER than 1 node" if b < 365.4 else "not faster than 1 node", 100 * 365.4 / (2 * b)))
    for a in ("h2w2", "h4w1", "h2w4"):
        if ms.get(a):
            print("  P3 sharding overhead %s: %+.1f %%" % (a, 100 * (ms[a] / b - 1)))
PY
echo "first logged loss per arm (not a gate; prereg 'phase 2' note):"
for arm in "${ORDER[@]}"; do
    [ -f "${OUT}/${arm}.out" ] || continue
    run="mn2n_b32_h${HP[$arm]}w${WP[$arm]}_real_rep${arm}_${JOBID}"
    l=$(grep -m1 -iE "loss" "${MEMBER_ROOT}/runs/makani_mn_scaling/${run}.log" 2>/dev/null)
    echo "  ${arm}: ${l:-<none>}"
done
summary=""
for arm in "${ORDER[@]}"; do summary="${summary} ${arm}=${RES[$arm]:-not_run}"; done
echo "SPATIAL_CXI_MATRIX_DONE ${n_ok}/${n_run}${summary} out=${OUT}"

# ---- after the arms, never during them: the F0/F1 unit suites on this tree -----
# (7668637 ran them beside a smoke; here they would perturb step times, so they go
# last.) Re-checks POLARIS_SCRIPT_TESTS after the test_regional_scores fix.
if [ "${RUN_TESTS:-1}" = "1" ]; then
    echo "=== F0/F1 unit suites (sequential, after the matrix) ==="
    bash "${MAKANI_ROOT}/polaris/polaris_f_finetune_tests.pbs" > "${OUT}/unit_tests.out" 2>&1
    grep -E "^[A-Z_]+_OK |^F_FINETUNE_TESTS_OK|^ERROR" "${OUT}/unit_tests.out"
fi

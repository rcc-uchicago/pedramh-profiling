#!/bin/bash -l
#PBS -N makani_climate_fidelity_test
#PBS -A lighthouse-uchicago
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l filesystems=home:eagle
#PBS -l walltime=00:30:00
#PBS -r n
#PBS -j oe
# ============================================================================
# CPU-only pytest gate for build_true_climatology.py / score_climate_fidelity.py
# (jesswan's climate-fidelity request, makani-B-continuation handoff follow-up,
# 2026-10-03). No GPU needed -- everything here is dataset/numpy math.
#
# PASS = CLIMATE_FIDELITY_TEST_OK
# Submit from makani_sfno/:   qsub polaris/polaris_climate_fidelity_test.pbs
# ============================================================================

cd "${PBS_O_WORKDIR}" || exit 2
MAKANI_ROOT="$(cd "${PBS_O_WORKDIR}" && pwd)"
if [ ! -d "${MAKANI_ROOT}/src/sfno_inference" ]; then
    MAKANI_ROOT="$(cd "${PBS_O_WORKDIR}/.." && pwd)"
fi
REPO="$(cd "${MAKANI_ROOT}/.." && pwd)"

# shellcheck disable=SC1091
source "${REPO}/polaris_env.sh" || exit 2
# shellcheck disable=SC1091
source "${MAKANI_ROOT}/polaris/polaris_makani_env.sh" || exit 2

if [ ! -x "${SFNO_VENV}/bin/python" ]; then
    echo "ERROR SFNO_VENV_MISSING: ${SFNO_VENV}"
    exit 3
fi
# shellcheck disable=SC1091
source "${SFNO_VENV}/bin/activate"
export PYTHONNOUSERSITE=1
export PYTHONPATH="${MAKANI_ROOT}/src:${MAKANI_ROOT}/polaris:${PYTHONPATH:-}"
export HDF5_USE_FILE_LOCKING=FALSE
PY="${SFNO_VENV}/bin/python"

echo "=== makani_climate_fidelity_test: $(date -Iseconds) ==="
echo "host=$(hostname)  PBS_JOBID=${PBS_JOBID}  sha=$(cd "${REPO}" && git rev-parse --short=7 HEAD 2>/dev/null)"
makani_env_report
echo

CUDA_VISIBLE_DEVICES="" "${PY}" -m pytest -q -p no:cacheprovider \
    "${MAKANI_ROOT}/polaris/test_build_true_climatology.py" \
    "${MAKANI_ROOT}/polaris/test_score_climate_fidelity.py" 2>&1 | tail -60
rc=${PIPESTATUS[0]}
if [ "${rc}" -eq 0 ]; then
    echo "CLIMATE_FIDELITY_TEST_OK"
else
    echo "ERROR CLIMATE_FIDELITY_TEST_FAILED rc=${rc}"
fi
echo "=== makani_climate_fidelity_test done $(date -Iseconds) ==="

#!/bin/bash -l
#PBS -N pploop-warmtrace
#PBS -A lighthouse-uchicago
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l filesystems=home:eagle
#PBS -l walltime=00:55:00
#PBS -j oe
# ============================================================================
# Is the 39-41% step-time variance in EVERY nsys capture cold start, or nsys?
#
# Three tiers are now on record, and they stack:
#   single-arm + nsys (7255557, 7545291)   step_std/med = 39-41%
#   first arm, untraced (gcA1, gcW)                       9-12%
#   warm arms, untraced                                0.09-0.19%
#
# Every profiling capture in this project is a SINGLE-ARM, COLD, TRACED run --
# so every tail metric in §4.4 (NCCL 67.82 vs 145.65 ms/rank-step, "19 of 40
# steps stalled", dev0 out of phase) may be measurement artifact rather than a
# property of the workload. That matters: §4.4d/§4.4e built an "undiagnosed
# host-CPU stall" story on it, and plan item 6b(B) exists to explain it.
#
# This separates the two causes with one job: an untraced warm-up arm, then a
# TRACED arm. Compare its step_std/med against 7545291's 40.56%.
#   ~0.2%  => the 40% was cold start; nsys is cheap and future captures just
#             need a warm-up arm first.
#   ~30-40% => nsys itself is the contaminant and every capture's tail metrics
#             are suspect, including the ones §4.4 rests on.
#
# Median step time also separates them: warm untraced runs sit at 0.650-0.653 s,
# the traced 7545291 at 0.677 (+3.7%).
#
# PASS = WARMTRACE_OK plus 2 CSV rows and a non-empty NVTX table.
# ============================================================================
set -u
cd "${PBS_O_WORKDIR}"
REPO="${PBS_O_WORKDIR}"
V20_DIR="${REPO}/PanguWeather/v2.0"

module use /soft/modulefiles
module load conda 2>/dev/null || true
conda activate base 2>/dev/null || true
# shellcheck disable=SC1091
source "${REPO}/polaris_env.sh" || exit 2
export PYTHONNOUSERSITE=1 WANDB_MODE=offline HDF5_USE_FILE_LOCKING=FALSE
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True MPLBACKEND=Agg
export OMP_NUM_THREADS=8 MKL_NUM_THREADS=8
unset NCCL_DEBUG TORCH_DISTRIBUTED_DEBUG
export TORCH_NCCL_ASYNC_ERROR_HANDLING=1
ulimit -l unlimited

PY="${AI_ROSSBY_VENV}/bin/python"
SHIM="${MEMBER_ROOT}/conda-envs/pangu-shim"
GCSHIM="${MEMBER_ROOT}/conda-envs/pangu-gcshim"
[ -x "${PY}" ] || { echo "ERROR VENV_MISSING"; exit 3; }

export PANGU_BENCH=1 PANGU_NVTX=0
export PANGU_BENCH_WARMUP=20 PANGU_BENCH_STEPS=40
export PANGU_BENCH_CSV="${MEMBER_ROOT}/bench/pangu_warmtrace_t210.csv"
mkdir -p "$(dirname "${PANGU_BENCH_CSV}")"

CONFIG_FILE="${MEMBER_ROOT}/pangu_e3sm_sfno.warmtrace.rendered.yaml"
sed -e "s|{{PANGU_AUX}}|${PANGU_AUX}|g" -e "s|{{MEMBER_ROOT}}|${MEMBER_ROOT}|g" \
    "${V20_DIR}/config/E3SM_SFNO_H5_POLARIS.yaml" > "${CONFIG_FILE}"

echo "=== gc A/B: $(date -Iseconds)  host=$(hostname) ==="
"${PY}" -c "import torch;print('torch',torch.__version__)"

run_arm () {                    # run_arm <label> <gc_off:0|1>
    local label="$1" gcoff="$2"
    local run="gc${label}_${PBS_JOBID%%.*}"
    echo
    echo "########## arm ${label}  (PANGU_GC_OFF=${gcoff})  run_num=${run} ##########"
    if [ "${gcoff}" = "1" ]; then
        export PYTHONPATH="${V20_DIR}:${SHIM}:${GCSHIM}"
        export PANGU_GC_OFF=1
    else
        export PYTHONPATH="${V20_DIR}:${SHIM}"
        unset PANGU_GC_OFF
    fi
    export S2S_YAML="${CONFIG_FILE}" S2S_RUN_NUM="${run}"
    "${PY}" -m torch.distributed.run --standalone --nproc_per_node=4 \
        "${V20_DIR}/train.py" --yaml_config="${CONFIG_FILE}" \
        --run_num="${run}" --config=SFNO --fresh_start --epochs 1 2>&1 \
        | grep -E "gc.disable|BENCH|ERROR|Error|Traceback" | head -20
    echo "  arm ${label} rc=$?"
}

# W = throwaway WARM-UP arm, discarded. Job 7549941 showed the whole apparent
# effect was the FIRST arm: A1 stalled (step_std 0.0770, loader_wait_frac 0.0056)
# while A2 -- same GC state, same node -- was clean at 0.00058. Without a warm-up
# arm the treatment and "first in the job" are confounded, and the plain A-then-B
# ordering would have published a false positive.
run_arm W 0                      # untraced warm-up, discarded

# ---- the traced arm, warm ----
export PANGU_NVTX=1
NSYS_BIN=/soft/compilers/cudatoolkit/cuda-12.9.1/bin/nsys
NSYS_OUT="${MEMBER_ROOT}/bench/nsys_pangu_warm_${PBS_JOBID%%.*}"
run="gcT_${PBS_JOBID%%.*}"
export PYTHONPATH="${V20_DIR}:${SHIM}"; unset PANGU_GC_OFF
export S2S_YAML="${CONFIG_FILE}" S2S_RUN_NUM="${run}"
echo
echo "########## TRACED arm (warm), run_num=${run} ##########"
"${NSYS_BIN}" profile --trace=cuda,nvtx,cudnn,cublas,osrt \
    --capture-range=cudaProfilerApi --capture-range-end=stop \
    --output="${NSYS_OUT}" --force-overwrite=true \
    "${PY}" -m torch.distributed.run --standalone --nproc_per_node=4 \
      "${V20_DIR}/train.py" --yaml_config="${CONFIG_FILE}" \
      --run_num="${run}" --config=SFNO --fresh_start --epochs 1 2>&1 \
    | grep -E "BENCH|ERROR|Error|Traceback" | head -10
[ -s "${NSYS_OUT}.nsys-rep" ] || { echo "ERROR NO_NSYS_REP"; exit 4; }
"${NSYS_BIN}" export --type=sqlite --force-overwrite=true \
    --output="${NSYS_OUT}.sqlite" "${NSYS_OUT}.nsys-rep" >/dev/null || { echo "ERROR EXPORT"; exit 4; }
echo "--- per-step series on the WARM traced capture ---"
"${PY}" "${REPO}/ACE2_retrain/nvtx_phase_attribution.py" "${NSYS_OUT}.sqlite" --per-step 2>&1 | tail -12

echo
echo "=== CSV rows for this job ==="
"${PY}" - "${PANGU_BENCH_CSV}" "${PBS_JOBID%%.*}" <<'_PY'
import csv, sys
path, jid = sys.argv[1], sys.argv[2]
rows = [r for r in csv.DictReader(open(path)) if jid in r["run_num"]]
# Drop the warm-up arm from the comparison, but PRINT it, so the discard is
# visible rather than silent.
warm = [r for r in rows if r["run_num"].startswith("gcW")]
rows = [r for r in rows if not r["run_num"].startswith("gcW")]
if not rows:
    print("ERROR NO_CSV_ROWS"); sys.exit(4)
cols = ["run_num", "step_med", "step_p90", "step_mean", "step_std",
        "peak_mem_gb_max_rank", "n_steps_counted"]
w = [max(len(c), 12) for c in cols]
print("  " + "".join(f"{c:>{n+2}}" for c, n in zip(cols, w)))
for r in warm:
    print("  " + "".join(f"{r.get(c,'?'):>{n+2}}" for c, n in zip(cols, w))
          + "   <- WARM-UP, discarded")
for r in rows:
    print("  " + "".join(f"{r.get(c,'?'):>{n+2}}" for c, n in zip(cols, w)))
def agg(pred, key):
    v = [float(r[key]) for r in rows if pred(r["run_num"])]
    # sum/len, not statistics.fmean: fmean is 3.8+ and this must also run
    # under the login node's python 3.6 for offline re-analysis.
    return (sum(v) / len(v)) if v else float("nan")
A = lambda n: "gcA" in n
B = lambda n: "gcB" in n
print()
for key in ("step_med", "step_p90", "step_std", "peak_mem_gb_max_rank"):
    a, b = agg(A, key), agg(B, key)
    print(f"  {key:22} A(gc on)={a:9.4f}  B(gc off)={b:9.4f}  "
          f"B/A={b/a if a else float('nan'):.4f}")
print("\n  A stall signature: step_p90/step_med = "
      f"{agg(A,'step_p90')/agg(A,'step_med'):.3f}   "
      f"B: {agg(B,'step_p90')/agg(B,'step_med'):.3f}")
_PY

echo "WARMTRACE_OK"

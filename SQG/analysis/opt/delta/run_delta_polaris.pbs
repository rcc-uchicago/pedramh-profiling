#!/bin/bash -l
#PBS -N sqg_delta_fid
#PBS -A lighthouse-uchicago
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l filesystems=home:eagle
#PBS -l walltime=00:50:00
#PBS -j oe
# run_delta_polaris.pbs -- does a float32 solver damage o1.2's training delta theta(t + 0.02) - theta(t)? One Polaris
# A100 (GPU 0). Predictions + the pre-set gate: SQG/analysis/opt/delta/PREDICTIONS_delta.md (written first).
#   qsub -o /eagle/projects/lighthouse-uchicago/members/<you>/sqg_profile/logs/ [-v STATE_IN=<npz>] \
#        SQG/analysis/opt/delta/run_delta_polaris.pbs                                   (from the repo root)
# 1. test_f32_update.py (emulated float32; F32_UPDATE_TEST_OK).
# 2. delta_fidelity.py: spin-up (or STATE_IN), per-band increments, 8 x 4,000-step pairs for mixed / lean32 /
#    lean32e / lean32ek vs float64 (lean_u1, checked bitwise against production on pair 0) and the f64ic32 control,
#    the gate (DELTA_GATE x4), timing (DELTA_BENCH), DELTA_DONE.
# End token: DELTA_JOB_DONE failures=N. JSON + log -> SQG/analysis/results/polaris_delta_<jobid>/; the spun-up state
# (npz, ~0.4 GB) stays in $MEMBER_ROOT/sqg_profile/delta_<jobid>/ for later jobs (STATE_IN).
set -eo pipefail
cd "${PBS_O_WORKDIR}"

# ---- env bootstrap (the same block in every SQG Polaris script; no module is loaded: CUDA comes from the wheels) --
MEMBERS=/eagle/projects/lighthouse-uchicago/members
if [ -z "${MEMBER_ROOT:-}" ]; then                     # as polaris_env.sh: the member dir is not always $USER
    if [ -w "${MEMBERS}/${USER}" ]; then MEMBER_ROOT="${MEMBERS}/${USER}"
    else for d in "${MEMBERS}"/*/; do if [ -O "$d" ] && [ -w "$d" ]; then MEMBER_ROOT="${d%/}"; break; fi; done; fi
fi
[ -n "${MEMBER_ROOT:-}" ] && [ -w "$MEMBER_ROOT" ] || { echo "ERROR SQG_NO_MEMBER_ROOT: ${MEMBER_ROOT:-<unset>}"; exit 2; }
PY="${SQG_PY:-${MEMBER_ROOT}/conda-envs/sqg-env/bin/python}"
[ -x "$PY" ] || { echo "ERROR SQG_ENV_MISSING: $PY (build it: bash -l SQG/polaris/setup_sqg_env.sh)"; exit 3; }
unset PYTHONPATH PYTHONHOME
export PYTHONNOUSERSITE=1 XLA_PYTHON_CLIENT_PREALLOCATE=false HDF5_USE_FILE_LOCKING=FALSE \
       OMP_NUM_THREADS=8 PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True CUDA_VISIBLE_DEVICES=0 \
       TMPDIR="${MEMBER_ROOT}/tmp" WANDB_MODE=offline
export SQG_ASQG_PY="${PBS_O_WORKDIR}/SQG/fixed_ring/A-SQG_data.py"
export SQG_TRAINING_ROOT="${SQG_TRAINING_ROOT:-${MEMBER_ROOT}/sqg_stage/AllTrainData}"   # the solver mkdirs here
JOB="${PBS_JOBID%%.*}"
# ------------------------------------------------------------------------------------------------------------------
OUT="${MEMBER_ROOT}/sqg_profile/delta_${JOB}"
RES="SQG/analysis/results/polaris_delta_${JOB}"
mkdir -p "$OUT" "$RES" "$TMPDIR" "$SQG_TRAINING_ROOT"
(cd SQG/fixed_ring && sha256sum -c --quiet SHA256SUMS) || { echo "ERROR SQG_SOLVER_SHA_MISMATCH"; exit 4; }
T0=$(date +%s)
FAILURES=0
fail() { echo "ERROR $*"; FAILURES=$((FAILURES + 1)); }
echo "=== run_delta on $(hostname) job $JOB: $(date '+%F %T') ==="
echo "host=$(hostname) job=$JOB py=$PY out=$OUT state_in=${STATE_IN:-<spin-up>}"
nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv | tee "$OUT/gpu.csv"

"$PY" SQG/analysis/opt/delta/test_f32_update.py 2>&1 | tee "$OUT/test_f32_update.log" || fail F32_UPDATE_TEST
grep -q "F32_UPDATE_TEST_OK" "$OUT/test_f32_update.log" || fail F32_UPDATE_TEST_NO_TOKEN

ARGS=(--out "$OUT")
if [ -n "${STATE_IN:-}" ]; then ARGS+=(--state-in "$STATE_IN"); else ARGS+=(--state-out "$OUT/spinup_state_${JOB}.npz"); fi
"$PY" SQG/analysis/opt/delta/delta_fidelity.py "${ARGS[@]}" 2>&1 | tee "$OUT/delta_fidelity.log" || fail DELTA_RC
grep -q "DELTA_DONE" "$OUT/delta_fidelity.log" || fail DELTA_NO_TOKEN

for f in "$OUT"/*.json "$OUT"/*.log "$OUT"/gpu.csv; do
    [ -e "$f" ] && cp "$f" "$RES"/
done
echo "=== end $(date '+%F %T') ($(( $(date +%s) - T0 )) s)"
echo "DELTA_JOB_DONE failures=$FAILURES"

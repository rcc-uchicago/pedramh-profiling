#!/bin/bash -l
#PBS -N sqg_opt_round1
#PBS -A lighthouse-uchicago
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l filesystems=home:eagle
#PBS -l walltime=00:55:00
#PBS -j oe
# run_round1_polaris.pbs -- round 1 of the SQG solver-step speed-ups, one combined debug job on one Polaris A100 (GPU 0).
# Two seeds, run one after the other on the SAME GPU so their ms/step are comparable (SQG/analysis/opt/PREDICTIONS_round1.md
# holds the pre-registered predictions; the verdicts are in the main session's report):
#   seed 1  SQG/analysis/opt/seed1/run_seed1.py   float64, JAX level: lean, lean_u1, lean_split   (~10 min, self-budgeted 14)
#   seed 2  SQG/analysis/opt/seed2/seed2_opt.py   C2C-packed u/v + ring: lean64, mixed, lean32    (~7 min, worst ~12.5)
# Each seed is wrapped in `timeout` so one hang cannot eat the walltime, and the job does NOT `set -e`: a failing seed is
# reported (ERROR OPT_ROUND1_SEED<n>_FAILED) and the other still runs. Every variant is gated by its pre-set tolerance vs
# the production step (GD.inner under the 40-step lax.scan); bitwise equality is reported as information only.
#   qsub -o /eagle/projects/lighthouse-uchicago/members/<you>/sqg_profile/logs/ SQG/analysis/opt/run_round1_polaris.pbs
# PASS = "SEED1_DONE", "SEED2_DONE", "OPT_RANK_OK" and the final "OPT_ROUND1_DONE" in the .o file; the per-variant
# tokens are SEED1_GATE_OK|ERROR SEED1_GATE_FAIL <v> ..., SEED2_GATE_OK|ERROR SEED2_GATE_FAIL <v> ..., SEED*_BENCH, SEED*_OPTSTEP.
# Text summaries (JSON, HLO, logs, ranking) -> SQG/analysis/results/polaris_opt_round1_<jobid>/; nothing binary is produced.
# No install and no build: both seeds run in sqg-env as is (an optional seed<n>/setup_in_job.sh hook exists for later rounds).
set -o pipefail
cd "${PBS_O_WORKDIR}"

# ---- env bootstrap (the same block in every SQG Polaris script; no module is loaded: CUDA comes from the wheels) --
MEMBERS=/eagle/projects/lighthouse-uchicago/members
if [ -z "${MEMBER_ROOT:-}" ]; then                     # as polaris_env.sh: the member dir is not always $USER
    if [ -w "${MEMBERS}/${USER}" ]; then MEMBER_ROOT="${MEMBERS}/${USER}"
    else for d in "${MEMBERS}"/*/; do if [ -O "$d" ] && [ -w "$d" ]; then MEMBER_ROOT="${d%/}"; break; fi; done; fi
fi
[ -n "${MEMBER_ROOT:-}" ] && [ -w "$MEMBER_ROOT" ] || { echo "ERROR SQG_NO_MEMBER_ROOT: ${MEMBER_ROOT:-<unset>}"; exit 2; }
PY="${SQG_PY:-${MEMBER_ROOT}/conda-envs/sqg-env/bin/python}"
[ -x "$PY" ] || { echo "ERROR SQG_ENV_MISSING: $PY (build it: bash -l SQG/polaris/setup_sqg_env.sh)"; exit 3; }
unset PYTHONPATH PYTHONHOME
export PYTHONNOUSERSITE=1 XLA_PYTHON_CLIENT_PREALLOCATE=false HDF5_USE_FILE_LOCKING=FALSE \
       OMP_NUM_THREADS=8 PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True CUDA_VISIBLE_DEVICES=0 \
       TMPDIR="${MEMBER_ROOT}/tmp" WANDB_MODE=offline
export SQG_ASQG_PY="${PBS_O_WORKDIR}/SQG/fixed_ring/A-SQG_data.py"
export SQG_TRAINING_ROOT="${SQG_TRAINING_ROOT:-${MEMBER_ROOT}/sqg_stage/AllTrainData}"   # the solver mkdirs here
export SQG_INIT="${SQG_INIT:-random}"
JOB="${PBS_JOBID%%.*}"
OUT="${MEMBER_ROOT}/sqg_profile/opt_round1_${JOB}"
RES="SQG/analysis/results/polaris_opt_round1_${JOB}"
mkdir -p "$OUT" "$RES" "$TMPDIR" "$SQG_TRAINING_ROOT"
(cd SQG/fixed_ring && sha256sum -c --quiet SHA256SUMS) || { echo "ERROR SQG_SOLVER_SHA_MISMATCH"; exit 4; }
echo "=== opt_round1 on $(hostname) job $JOB: $(date '+%F %T') ==="
echo "host=$(hostname) job=$JOB py=$PY init=$SQG_INIT out=$OUT"
echo "LD_LIBRARY_PATH=${LD_LIBRARY_PATH:-}"
echo "modules: $(module -t list 2>&1 | tr '\n' ' ')"
nvidia-smi --query-gpu=name,driver_version,memory.total,clocks.max.sm,clocks.max.mem,power.limit --format=csv | tee "$OUT/gpu.csv"
# ------------------------------------------------------------------------------------------------------------------
OPT=SQG/analysis/opt
T_JOB0=$(date +%s)
FAILS=0

# ---- stdlib pre-checks (seconds; the same tests that passed on the login node) ------------------------------------
"$PY" "$OPT/seed1/test_lean_ring.py"        || { echo "ERROR OPT_ROUND1_SEED1_RING_TEST_FAILED"; FAILS=$((FAILS + 1)); }
"$PY" "$OPT/seed2/test_build_w_stdlib.py"   || { echo "ERROR OPT_ROUND1_SEED2_BUILDW_TEST_FAILED"; FAILS=$((FAILS + 1)); }
"$PY" "$OPT/test_rank_round1.py"            || { echo "ERROR OPT_ROUND1_RANK_TEST_FAILED"; FAILS=$((FAILS + 1)); }

# ---- one seed: optional setup hook, then the entry script under `timeout`; the PASS token decides, not the rc -----
run_seed() {   # run_seed <n> <timeout_s> <done_token> <entry.py> [args...]
    local n="$1" tmo="$2" token="$3" entry="$4"; shift 4
    local log="$OUT/seed${n}.log" rc=0 t0 t1
    echo "--- seed $n: $entry $* (timeout ${tmo}s)  $(date '+%T')"
    if [ -f "$OPT/seed${n}/setup_in_job.sh" ]; then
        # Any in-job install/build goes into $MEMBER_ROOT/sqg_opt_env/ (never into sqg-env). Compute nodes reach the
        # internet only through ALCF's HTTP proxy; these are the variables such a hook can rely on.
        export http_proxy="http://proxy.alcf.anl.gov:3128" https_proxy="http://proxy.alcf.anl.gov:3128" \
               HTTP_PROXY="http://proxy.alcf.anl.gov:3128" HTTPS_PROXY="http://proxy.alcf.anl.gov:3128" \
               SQG_OPT_ENV="${MEMBER_ROOT}/sqg_opt_env"
        mkdir -p "$SQG_OPT_ENV"
        echo "seed $n: running setup_in_job.sh (flagged: this round was declared install-free)"
        timeout -k 30 600 bash "$OPT/seed${n}/setup_in_job.sh" 2>&1 | tee "$OUT/seed${n}_setup.log"
        rc=${PIPESTATUS[0]}
        [ "$rc" -eq 0 ] || { echo "ERROR OPT_ROUND1_SEED${n}_SETUP_FAILED rc=$rc"; FAILS=$((FAILS + 1)); return 1; }
    fi
    t0=$(date +%s)
    timeout -k 60 "$tmo" "$PY" "$entry" "$@" 2>&1 | tee "$log"
    rc=${PIPESTATUS[0]}
    t1=$(date +%s)
    echo "seed $n: rc=$rc wall=$((t1 - t0))s  $(date '+%T')"
    if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then
        echo "ERROR OPT_ROUND1_SEED${n}_TIMEOUT after ${tmo}s (partial JSON, if any, is still copied)"
        FAILS=$((FAILS + 1)); return 1
    fi
    if ! grep -q "$token" "$log"; then
        echo "ERROR OPT_ROUND1_SEED${n}_FAILED rc=$rc: no $token in $log"
        FAILS=$((FAILS + 1)); return 1
    fi
    return 0
}

# ---- seed 1 (float64, JAX level): gates G1-G3, bench, optimizer step, 4,000-step information run ------------------
run_seed 1 1320 SEED1_DONE "$OPT/seed1/run_seed1.py" --out "$OUT/seed1" --budget-min 14

# ---- seed 2 (C2C-packed u/v, ring, lean fusion; f64 / mixed / f32): gates, long runs, bench, optimizer step ------
run_seed 2 1200 SEED2_DONE "$OPT/seed2/seed2_opt.py" --out "$OUT/seed2"

# ---- text summaries into the repo (JSON, logs, ranking; optimized HLO only while small) ---------------------------
for f in "$OUT"/seed1/seed1.json "$OUT"/seed2/seed2.json "$OUT"/*.log "$OUT"/gpu.csv; do
    [ -e "$f" ] && cp "$f" "$RES"/
done
for f in "$OUT"/seed1/hlo_*.txt "$OUT"/seed2/hlo_*.txt; do
    [ -e "$f" ] && [ "$(stat -c %s "$f")" -lt 2000000 ] && cp "$f" "$RES"/
done

# ---- the ranking (stdlib): failed gates never win, bitwise is information only ----------------------------------
"$PY" "$OPT/rank_round1.py" --seed1 "$OUT/seed1/seed1.json" --seed2 "$OUT/seed2/seed2.json" \
      --out "$RES/ranking_round1.txt" || { echo "ERROR OPT_ROUND1_RANK_FAILED"; FAILS=$((FAILS + 1)); }
[ -e "$RES/ranking_round1.txt" ] && cp "$RES/ranking_round1.txt" "$OUT"/

# ---- token roll-up for the reader of the .o file -----------------------------------------------------------------
echo "--- tokens:"
cat "$OUT"/seed1.log "$OUT"/seed2.log 2>/dev/null | grep -E '^(SEED[12]_(GATE_OK|BENCH|OPTSTEP|LONG|DONE)|ERROR |WARN )' || true
echo "summaries: $RES ($(ls -1 "$RES" 2>/dev/null | wc -l) files); raw dir: $OUT"
echo "=== end $(date '+%F %T'), $(( $(date +%s) - T_JOB0 ))s, failures=$FAILS ==="
echo "OPT_ROUND1_DONE failures=$FAILS"

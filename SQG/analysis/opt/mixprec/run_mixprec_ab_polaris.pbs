#!/bin/bash -l
#PBS -N sqg_mpab
#PBS -A lighthouse-uchicago
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -j oe
# run_mixprec_ab_polaris.pbs -- probe 1 of PREDICTIONS_mixprec.md (written first): tilerows_inrow_if25 with its
# intermediates stored in 16 bits (mixprec.py: fixed bf16 / fp16, fp16 above k_x = 128, adaptive per column), judged
# by gates A and B unchanged (tilegates/tr_pairs.py + gates_ab_tr.py, the 64 taxonomy pairs) against the @none arm.
#   python3 SQG/analysis/opt/stability/snapshot_src.py <snap>                    (from the repo root: freeze the code)
#   qsub -v TR_SRC=<snap> -o /eagle/projects/lighthouse-uchicago/members/<you>/sqg_profile/logs/ \
#        SQG/analysis/opt/mixprec/run_mixprec_ab_polaris.pbs
# 0. test_tilerows_advance.py + test_mixprec.py torch.  1. 4 x tr_pairs.py (MP_ARMS).  2. gates_ab_tr.py once per arm
# (that arm the candidate) -> <res>/<arm>/.  3. analyze_mixprec.py (V_wrap vs job 7854208's frames; classes; prize).
# End token (every exit path): MPAB_JOB_DONE failures=N. Results -> SQG/analysis/results/polaris_mpab_<jobid>/.
set -eo pipefail
FAILURES=0
DONE_PRINTED=0
fail() { echo "ERROR $*"; FAILURES=$((FAILURES + 1)); }
finish() {
    rc=$?
    if [ "$DONE_PRINTED" -eq 0 ]; then
        [ "$rc" -ne 0 ] && { echo "ERROR MPAB_JOB_EXIT rc=$rc"; FAILURES=$((FAILURES + 1)); }
        echo "MPAB_JOB_DONE failures=$FAILURES"
    fi
}
trap finish EXIT
cd "${PBS_O_WORKDIR}"
REPO="${PBS_O_WORKDIR}"
SRC="${TR_SRC:-${REPO}}"

# ---- env bootstrap (the same block in every SQG Polaris script; no module is loaded: CUDA comes from the wheels) --
MEMBERS=/eagle/projects/lighthouse-uchicago/members
if [ -z "${MEMBER_ROOT:-}" ]; then                     # as polaris_env.sh: the member dir is not always $USER
    if [ -w "${MEMBERS}/${USER}" ]; then MEMBER_ROOT="${MEMBERS}/${USER}"
    else for d in "${MEMBERS}"/*/; do if [ -O "$d" ] && [ -w "$d" ]; then MEMBER_ROOT="${d%/}"; break; fi; done; fi
fi
[ -n "${MEMBER_ROOT:-}" ] && [ -w "$MEMBER_ROOT" ] || { echo "ERROR SQG_NO_MEMBER_ROOT: ${MEMBER_ROOT:-<unset>}"; exit 2; }
PY="${SQG_PY:-${MEMBER_ROOT}/conda-envs/sqg-env/bin/python}"
[ -x "$PY" ] || { echo "ERROR SQG_ENV_MISSING: $PY (build it: bash -l SQG/polaris/setup_sqg_env.sh)"; exit 3; }
unset PYTHONPATH PYTHONHOME
export PYTHONNOUSERSITE=1 XLA_PYTHON_CLIENT_PREALLOCATE=false HDF5_USE_FILE_LOCKING=FALSE \
       OMP_NUM_THREADS=8 PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True CUDA_VISIBLE_DEVICES=0 \
       TMPDIR="${MEMBER_ROOT}/tmp" WANDB_MODE=offline
export SQG_ASQG_PY="${SRC}/SQG/fixed_ring/A-SQG_data.py"
export SQG_TRAINING_ROOT="${SQG_TRAINING_ROOT:-${MEMBER_ROOT}/sqg_stage/AllTrainData}"   # the solver mkdirs here
JOB="${PBS_JOBID%%.*}"
# ------------------------------------------------------------------------------------------------------------------
export PYTHONUNBUFFERED=1
WARP_PATH="${WARP_PATH:-${MEMBER_ROOT}/pylibs/warp-1.17.0}"
NVMATH_PATH="${NVMATH_PATH:-${MEMBER_ROOT}/pylibs/nvmath-1.0.0}"
TAXO="${TAXO:-${MEMBER_ROOT}/sqg_profile/taxonomy_7824121}"
WRAP="${WRAP:-${MEMBER_ROOT}/sqg_profile/trab_7854208}"              # job 7854208's tilerows_inrow_if25 frames
B="tilerows_inrow_if25"
MP_ARMS="${MP_ARMS:-$B@none+$B@bf16_all+$B@fp16_all+$B@fp16_kx128+$B@ad1+$B@ad32+$B@ad1024}"
ARMS="${MP_ARMS//+/,}"
OUT="${MEMBER_ROOT}/sqg_profile/mpab_${JOB}"
RES="${REPO}/SQG/analysis/results/polaris_mpab_${JOB}"
mkdir -p "$OUT" "$RES" "$TMPDIR" "$SQG_TRAINING_ROOT"
cd "$SRC"
(cd SQG/fixed_ring && sha256sum -c --quiet SHA256SUMS) || { echo "ERROR SQG_SOLVER_SHA_MISMATCH"; exit 4; }
if [ "$SRC" != "$REPO" ]; then
    sha256sum -c --quiet MANIFEST.sha256 || { echo "ERROR MPAB_SNAPSHOT_MANIFEST"; exit 4; }
    cp MANIFEST.sha256 GIT_HEAD "$OUT"/
fi
HERE=SQG/analysis/opt/mixprec
TG=SQG/analysis/opt/tilegates
for d in "$WARP_PATH/warp" "$NVMATH_PATH/nvmath" "$TAXO/sealed" "$WRAP"; do
    [ -d "$d" ] || { echo "ERROR MPAB_INPUT_MISSING $d"; exit 5; }
done
T0=$(date +%s)
echo "=== run_mixprec_ab on $(hostname) job $JOB: $(date '+%F %T') src=$SRC arms=$MP_ARMS ==="
nvidia-smi --query-gpu=index,name,driver_version,memory.total --format=csv | tee "$OUT/gpu.csv"
sha256sum "$HERE"/*.py "$HERE"/PREDICTIONS_mixprec.md "$TG"/*.py SQG/analysis/opt/o12run/tilerows_advance.py \
    | tee "$OUT/sha256.txt"

# ---- 0. tests --------------------------------------------------------------------------------------------------------
"$PY" SQG/analysis/opt/o12run/test_tilerows_advance.py 2>&1 | tee "$OUT/test_tilerows_advance.log" || fail TR_TEST
grep -q "O12_TR_TEST_OK" "$OUT/test_tilerows_advance.log" || fail TR_TEST_NO_TOKEN
"$PY" "$HERE/test_mixprec.py" torch 2>&1 | tee "$OUT/test_mixprec.log" || fail MIXPREC_TEST
grep -q "MIXPREC_TEST_OK torch=ok" "$OUT/test_mixprec.log" || fail MIXPREC_TEST_NO_TOKEN
[ "$FAILURES" = "0" ] || { echo "ERROR MPAB_TESTS_FAILED (no arm run)"; exit 6; }

# ---- 1. the taxonomy job's states: worker w, state i = member ((w + i) mod 4) + 1 at t = TIMES[i] ---------------------
LABEL_TAIL="_frozen_ring_NU_B_v2_nu0.0002_B1_mu1_kf3.5_dkf0.5_seed1_N4096_dt5e-06_Tstart0_Tspin20_Tprod1100_save0.0025_pair0.02"
TIMES=(0100.00 0200.00 0300.00 0400.00)
declare -a WARGS
for w in 0 1 2 3; do
    a=""
    for i in 0 1 2 3; do
        m=$(( (w + i) % 4 + 1 ))
        f="${SQG_TRAINING_ROOT}/trainingdata_m0${m}${LABEL_TAIL}/checkpoint/ckpt_t${TIMES[$i]}.npz"
        [ -s "$f" ] || { echo "ERROR MPAB_CKPT_NOT_STAGED $f"; exit 5; }
        a="$a --ckpt ${m}:${f}"
    done
    WARGS[$w]="$a"
done
pids=()
for w in 0 1 2 3; do
    mkdir -p "$OUT/warp_cache_w$w"
    # shellcheck disable=SC2086
    CUDA_VISIBLE_DEVICES=$w WARP_CACHE_PATH="$OUT/warp_cache_w$w" "$PY" "$TG/tr_pairs.py" --out "$OUT" --worker $w \
        ${WARGS[$w]} --taxo "$TAXO" --warp-path "$WARP_PATH" --nvmath-path "$NVMATH_PATH" --arms "$ARMS" \
        > "$OUT/worker_${w}.log" 2>&1 &
    pids+=($!)
done
for w in 0 1 2 3; do
    wait "${pids[$w]}" || fail "MPAB_WORKER_RC w=$w"
    grep -q "TRAB_WORKER_DONE w=$w" "$OUT/worker_${w}.log" || fail "MPAB_WORKER_NO_TOKEN w=$w"
    grep -E "^(ERROR|TRAB_STATE|TRAB_WORKER_DONE)" "$OUT/worker_${w}.log" || true
done
echo "=== workers done $(date '+%F %T') ($(( $(date +%s) - T0 )) s)"

# ---- 2. gates A and B, each arm as the candidate ---------------------------------------------------------------------
for a in ${MP_ARMS//+/ }; do
    OPENBLAS_NUM_THREADS=8 "$PY" "$TG/gates_ab_tr.py" --taxo "$TAXO" --new "$OUT" --out "$RES/$a" --arms "$ARMS" \
        --candidate "$a" > "$OUT/gates_ab_tr_$a.log" 2>&1 || fail "MPAB_ANALYSIS_RC $a"
    grep -q "GATES_AB_TR_DONE" "$OUT/gates_ab_tr_$a.log" || fail "MPAB_ANALYSIS_NO_TOKEN $a"
    grep -E "^(TRAB_VALID|TRAB_VERDICT|TRAB_PATTERN)" "$OUT/gates_ab_tr_$a.log" || true
done
grep -E "^(GATE_A|GATE_B|TRAB_ACC)" "$OUT/gates_ab_tr_$B@none.log" || true

# ---- 3. classes, V_wrap, prize ---------------------------------------------------------------------------------------
"$PY" "$HERE/analyze_mixprec.py" --res "$RES" --new "$OUT" --wrap "$WRAP" --arms "$MP_ARMS" 2>&1 \
    | tee "$OUT/analyze_mixprec.log" || fail MPAB_SUMMARY_RC
grep -q "MIXPREC_DONE" "$OUT/analyze_mixprec.log" || fail MPAB_SUMMARY_NO_TOKEN

for f in "$OUT"/worker_*.json "$OUT"/*.log "$OUT"/gpu.csv "$OUT"/sha256.txt "$OUT"/MANIFEST.sha256 "$OUT"/GIT_HEAD; do
    if [ -e "$f" ]; then cp "$f" "$RES"/ || fail "MPAB_COPY $f"; fi
done
echo "=== end $(date '+%F %T') ($(( $(date +%s) - T0 )) s)"
DONE_PRINTED=1
echo "MPAB_JOB_DONE failures=$FAILURES"

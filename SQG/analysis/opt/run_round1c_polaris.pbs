#!/bin/bash -l
#PBS -N sqg_opt_r1c
#PBS -A lighthouse-uchicago
#PBS -q debug
#PBS -l select=2:system=polaris
#PBS -l place=scatter
#PBS -l filesystems=home:eagle
#PBS -l walltime=00:59:00
#PBS -j oe
# run_round1c_polaris.pbs -- one 2-node debug job, three phases (user decisions 2026-11-05, after job 7815096):
#  Phase 1  seed 1 rerun (lean / lean_u1 / lean_split) under round 1b's t rule (run_seed1.py ROUND 1b block), alone on
#           node 0's GPU 0 so the timings are clean.
#  Phase 2  the NCCL-over-CXI fix probe, 8 ranks, four arms in sequence (combine_handoffs' plan, 2026-11-05; FI_LOG is on
#           during A/B/D's timed rounds but not C's, so cross-arm busbw is indicative, not like-for-like):
#             A_filog  7815096's environment + FI_LOG_LEVEL=info: does libfabric fail to dlopen libcudart.so?
#             B_shim   + a dir holding libcudart.so -> the env's own libcudart.so.12 on LD_LIBRARY_PATH (the likely fix;
#                      the same file torch loads, so no second CUDA runtime), FI_LOG_LEVEL=info
#             C_loc    NCCL_NET_GDR_LEVEL=LOC (host-staged, no GPU memory registration): the fallback
#             D_cuda129 makani/ACE2's exact prepend, /soft/compilers/cudatoolkit/cuda-12.9.1/lib64 (ships libcudart.so ->
#                      12.9.79; a second CUDA runtime beside torch's 12.1), FI_LOG_LEVEL=info
#           PASS per arm = NCCL_PROBE_OK (multisim/probe_verdict.py: the all_reduce ran, values right, busbw measured).
#  Phase 3  replicate vs decouple with DDP over the first passing NCCL config (preference B_shim, D_cuda129, A_filog,
#           C_loc):
#             replicate lean32  o1.2 on all 8 GPUs (solver + DDP rank each), then the same steps under DDP.no_sync()
#             decouple  lean32  one DDP trainer per node (local rank 1) fed by its node's 3 simulators over gloo;
#                               free-running steps, then steps paced to 12 fresh pairs each (o1.2's recipe)
#             replicate ref     today's float64 solver, for the comparison with job B's 1-GPU 4.887 s/step
# Launch recipe from combine_handoffs (as run_round1b_multisim_polaris.pbs). OMP_NUM_THREADS=1 in phases 2-3 (their
# open flag: 8 OpenMP threads share the 8 bound cores with aws-ofi-nccl's progress thread).
#   qsub -o /eagle/projects/lighthouse-uchicago/members/<you>/sqg_profile/logs/ SQG/analysis/opt/run_round1c_polaris.pbs
# PASS = SEED1_DONE + OPT_RANK_OK (phase 1); >= 1 NCCL_PROBE_OK (phase 2); 3 x MULTISIM_OK (phase 3); final OPT_R1C_DONE.
# Predictions: SQG/analysis/opt/PREDICTIONS_round1c.md. Text summaries -> SQG/analysis/results/polaris_opt_round1c_<jobid>/.
set -o pipefail
cd "${PBS_O_WORKDIR}"

# ---- env bootstrap (the same block in every SQG Polaris script; no module is loaded: CUDA comes from the wheels) --
MEMBERS=/eagle/projects/lighthouse-uchicago/members
if [ -z "${MEMBER_ROOT:-}" ]; then                     # as polaris_env.sh: the member dir is not always $USER
    if [ -w "${MEMBERS}/${USER}" ]; then MEMBER_ROOT="${MEMBERS}/${USER}"
    else for d in "${MEMBERS}"/*/; do if [ -O "$d" ] && [ -w "$d" ]; then MEMBER_ROOT="${d%/}"; break; fi; done; fi
fi
[ -n "${MEMBER_ROOT:-}" ] && [ -w "$MEMBER_ROOT" ] || { echo "ERROR SQG_NO_MEMBER_ROOT: ${MEMBER_ROOT:-<unset>}"; exit 2; }
PY="${SQG_PY:-${MEMBER_ROOT}/conda-envs/sqg-env/bin/python}"
[ -x "$PY" ] || { echo "ERROR SQG_ENV_MISSING: $PY (build it: bash -l SQG/polaris/setup_sqg_env.sh)"; exit 3; }
unset PYTHONPATH PYTHONHOME
export PYTHONNOUSERSITE=1 XLA_PYTHON_CLIENT_PREALLOCATE=false HDF5_USE_FILE_LOCKING=FALSE \
       OMP_NUM_THREADS=8 PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True CUDA_VISIBLE_DEVICES=0 \
       TMPDIR="${MEMBER_ROOT}/tmp" WANDB_MODE=offline
export SQG_ASQG_PY="${PBS_O_WORKDIR}/SQG/fixed_ring/A-SQG_data.py"
export SQG_TRAINING_ROOT="${SQG_TRAINING_ROOT:-${MEMBER_ROOT}/sqg_stage/AllTrainData}"   # the solver mkdirs here
export SQG_INIT="${SQG_INIT:-random}"
JOB="${PBS_JOBID%%.*}"
OUT="${MEMBER_ROOT}/sqg_profile/opt_round1c_${JOB}"
RES="SQG/analysis/results/polaris_opt_round1c_${JOB}"
mkdir -p "$OUT" "$RES" "$TMPDIR" "$SQG_TRAINING_ROOT"
(cd SQG/fixed_ring && sha256sum -c --quiet SHA256SUMS) || { echo "ERROR SQG_SOLVER_SHA_MISMATCH"; exit 4; }
echo "=== opt_round1c on $(hostname) job $JOB: $(date '+%F %T') ==="
echo "host=$(hostname) job=$JOB py=$PY init=$SQG_INIT out=$OUT nodes=$(sort -u "$PBS_NODEFILE" | tr '\n' ' ')"
echo "LD_LIBRARY_PATH=${LD_LIBRARY_PATH:-}"
echo "modules: $(module -t list 2>&1 | tr '\n' ' ')"
nvidia-smi --query-gpu=name,driver_version,memory.total,clocks.max.sm,clocks.max.mem,power.limit --format=csv | tee "$OUT/gpu.csv"
# ------------------------------------------------------------------------------------------------------------------
OPT=SQG/analysis/opt
MS=$OPT/multisim
FAILS=0
T_JOB0=$(date +%s)
save_summaries() {   # text summaries into the repo after every phase, so a walltime kill keeps what finished
    local f
    for f in "$OUT"/seed1/seed1.json "$OUT"/seed1/hlo_seed1_*.txt "$OUT"/*.log "$OUT"/gpu.csv "$OUT"/probe_verdicts.txt \
             "$OUT"/multisim/*.json; do
        [ -e "$f" ] || continue
        [ "$(stat -c %s "$f")" -lt 3000000 ] && cp "$f" "$RES"/
    done
    return 0
}

# ================= phase 1: seed 1 under round 1b's t rule (node 0 GPU 0 alone) =====================================
echo "--- phase 1: seed 1 rerun  $(date '+%T')"
"$PY" "$OPT/seed1/test_lean_ring.py"      || { echo "ERROR OPT_R1C_SEED1_RING_TEST_FAILED"; FAILS=$((FAILS + 1)); }
"$PY" "$OPT/seed1/test_gate_round1b.py"   || { echo "ERROR OPT_R1C_SEED1_GATE_TEST_FAILED"; FAILS=$((FAILS + 1)); }
timeout -k 60 1080 "$PY" "$OPT/seed1/run_seed1.py" --out "$OUT/seed1" --budget-min 14 2>&1 | tee "$OUT/seed1.log"
rc=${PIPESTATUS[0]}
echo "seed 1: rc=$rc  $(date '+%T')"
grep -q SEED1_DONE "$OUT/seed1.log" || { echo "ERROR OPT_R1C_SEED1_FAILED rc=$rc"; FAILS=$((FAILS + 1)); }
"$PY" "$OPT/rank_round1.py" --seed1 "$OUT/seed1/seed1.json" --out "$RES/ranking_round1c_seed1.txt" \
    || { echo "ERROR OPT_R1C_RANK_FAILED"; FAILS=$((FAILS + 1)); }
save_summaries

# ================= phase 2: NCCL over CXI, three arms ================================================================
echo "--- phase 2: NCCL probe arms A_filog B_shim C_loc D_cuda129  $(date '+%T')"
unset CUDA_VISIBLE_DEVICES                                       # rank_env.sh gives each rank its own GPU
export TMPDIR=/tmp                                               # AF_UNIX path limit (combine_handoffs trap)
export OMP_NUM_THREADS=1                                         # combine_handoffs' flag: keep the cores for NCCL
export GPUS_PER_NODE=4 GPU_ORDER="${GPU_ORDER:-default}"
export MASTER_ADDR="$(head -1 "$PBS_NODEFILE")"
export GLOO_SOCKET_IFNAME="${GLOO_SOCKET_IFNAME:-hsn0}"         # gloo TCP over Slingshot
NNODES=$(sort -u "$PBS_NODEFILE" | wc -l)
NRANKS=$(( NNODES * GPUS_PER_NODE ))
PORT0=$(( 20000 + JOB % 20000 ))                                 # unique per job; + arm index per run
BASE_LD="${LD_LIBRARY_PATH:-}"
echo "nodes=$NNODES ranks=$NRANKS MASTER_ADDR=$MASTER_ADDR port0=$PORT0 GPU_ORDER=$GPU_ORDER OMP_NUM_THREADS=$OMP_NUM_THREADS"
"$PY" "$MS/test_probe_verdict.py" || { echo "ERROR OPT_R1C_PROBE_VERDICT_TEST_FAILED"; FAILS=$((FAILS + 1)); }

OFI_PLUGIN=/soft/libraries/aws-ofi-nccl/v1.6.0-libfabric-1.22.0/lib
OFI_LIBFABRIC=/opt/cray/libfabric/2.3.1/lib64
for _d in "$OFI_LIBFABRIC" "$OFI_PLUGIN" /soft/libraries/hwloc/lib; do
    [ -d "$_d" ] || echo "ERROR OFI_PATH_MISSING: $_d"
done
CUDART12=$(ls -1 "${PY%/bin/python}"/lib/python3*/site-packages/nvidia/cuda_runtime/lib/libcudart.so.12 2>/dev/null | head -1)
SHIM="$OUT/cudart_shim"                                          # on eagle: both nodes see it
mkdir -p "$SHIM"
[ -n "$CUDART12" ] && ln -sfn "$CUDART12" "$SHIM/libcudart.so" || echo "ERROR OPT_R1C_NO_CUDART12 (arm B_shim will fail)"
echo "cudart shim: $(ls -l "$SHIM/libcudart.so" 2>&1)"

nccl_env() {   # nccl_env <PHB|LOC> [dir to prepend]: combine_handoffs' block (polaris_nccl_debug_info.md), as 7815096
    export LD_LIBRARY_PATH="${2:+$2:}${OFI_LIBFABRIC}:${OFI_PLUGIN}:/soft/libraries/hwloc/lib:${BASE_LD}"
    export NCCL_NET="AWS Libfabric" NCCL_CROSS_NIC=1 NCCL_NET_GDR_LEVEL="$1" NCCL_PROTO=Simple \
           FI_CXI_DISABLE_HOST_REGISTER=1 FI_MR_CACHE_MONITOR=userfaultfd FI_CXI_DEFAULT_CQ_SIZE=131072 \
           FI_CXI_RDZV_PROTO=alt_read FI_CXI_RDZV_EAGER_SIZE=0 FI_CXI_RDZV_THRESHOLD=0 FI_CXI_RDZV_GET_MIN=0 \
           FI_CXI_DEFAULT_TX_SIZE=2048 FI_CXI_RX_MATCH_MODE=hybrid NCCL_DEBUG=INFO NCCL_DEBUG_SUBSYS=INIT,NET
}
CUDA129=/soft/compilers/cudatoolkit/cuda-12.9.1/lib64            # makani/ACE2's prepend (ships libcudart.so)
[ -e "$CUDA129/libcudart.so" ] || echo "ERROR OPT_R1C_NO_CUDA129_CUDART (arm D_cuda129 will fail)"
arm_env() {    # arm_env <A_filog|B_shim|C_loc|D_cuda129> [probe]: one arm's NCCL environment (FI_LOG only while probing)
    case "$1" in
        A_filog)   nccl_env PHB ;;
        B_shim)    nccl_env PHB "$SHIM" ;;
        C_loc)     nccl_env LOC ;;
        D_cuda129) nccl_env PHB "$CUDA129" ;;                    # a 12.9 runtime beside torch's 12.1 (two copies)
        *) echo "ERROR OPT_R1C_UNKNOWN_ARM $1"; return 1 ;;
    esac
    if [ "${2:-}" = probe ] && [ "$1" != C_loc ]; then export FI_LOG_LEVEL=info; fi
}
ms_launch() {  # ms_launch <port index> <timeout s> <log> <sqg_multisim args...>: all ranks; full output to <log> only
    local i="$1" tmo="$2" log="$3"; shift 3
    MASTER_PORT=$((PORT0 + i)) timeout -k 30 "$tmo" \
        mpiexec -n "$NRANKS" --ppn "$GPUS_PER_NODE" --hostfile "$PBS_NODEFILE" --cpu-bind depth -d 8 \
        --label --line-buffer bash "$MS/rank_env.sh" "$PY" "$MS/sqg_multisim.py" --out "$OUT/multisim" "$@" \
        > "$log" 2>&1
    local rc=$?
    grep -E 'MULTISIM|ERROR|Traceback' "$log" | grep -v 'NCCL INFO' | head -20
    return $rc
}

PROBE_OK=""
i=0
for arm in A_filog B_shim C_loc D_cuda129; do
    i=$((i + 1))
    log="$OUT/multisim_ncclprobe_${arm}.log"
    echo "--- NCCL probe $arm (port $((PORT0 + i)), timeout 180 s)  $(date '+%T')"
    ( arm_env "$arm" probe && ms_launch "$i" 180 "$log" --mode ncclprobe --solver ref --tag "$arm" --probe-mb 64 \
          --nccl-timeout 90 )
    echo "probe $arm: rc=$?  $(date '+%T')"
    if "$PY" "$MS/probe_verdict.py" "$OUT/multisim/multisim_ncclprobe_ref_${arm}.json" "$log" "$arm" \
            | tee -a "$OUT/probe_verdicts.txt"; then
        PROBE_OK="$PROBE_OK $arm"
    fi
done
save_summaries
DDP_ARM=""
for arm in B_shim D_cuda129 A_filog C_loc; do                    # one CUDA runtime first; host-staged last
    case " $PROBE_OK " in *" $arm "*) DDP_ARM="$arm"; break ;; esac
done
echo "NCCL_DDP_CONFIG ${DDP_ARM:-none} (passing probe arms:${PROBE_OK:- none})"

# ================= phase 3: replicate vs decouple, DDP over NCCL =====================================================
run_ddp() {    # run_ddp <port index> <timeout s> <mode> <solver> [args...]
    local i="$1" tmo="$2" mode="$3" solver="$4"; shift 4
    local log="$OUT/multisim_${mode}_${solver}.log"
    echo "--- $mode $solver, NCCL config $DDP_ARM (port $((PORT0 + i)), timeout ${tmo} s)  $(date '+%T')"
    ( arm_env "$DDP_ARM" && ms_launch "$i" "$tmo" "$log" --mode "$mode" --solver "$solver" "$@" )
    local rc=$?
    echo "$mode $solver: rc=$rc  $(date '+%T')"
    grep -q "MULTISIM_OK $mode $solver" "$log" || { echo "ERROR OPT_R1C_${mode}_${solver}_FAILED rc=$rc"; FAILS=$((FAILS + 1)); }
}
if [ -n "$DDP_ARM" ]; then
    echo "--- phase 3: replicate vs decouple  $(date '+%T')"
    run_ddp 5 330 replicate lean32 --steps 30 --nosync-steps 8
    save_summaries
    run_ddp 6 330 decouple  lean32 --seconds 110 --free-steps 40 --matched-steps 60 --trainer-local-rank 1
    save_summaries
    run_ddp 7 450 replicate ref    --steps 15 --nosync-steps 5
else
    echo "ERROR OPT_R1C_NO_NCCL_CONFIG: no probe arm passed, phase 3 skipped"
    FAILS=$((FAILS + 1))
fi
save_summaries
echo "--- tokens:"
cat "$OUT"/*.log "$OUT"/probe_verdicts.txt 2>/dev/null \
    | grep -E '(SEED1_(GATE_OK|BENCH|OPTSTEP|LONG|DONE)|NCCL_PROBE_OK|NCCL_PROBE_FAILED|MULTISIM |MULTISIM_OK|ERROR |WARN )' \
    | grep -v 'NCCL INFO' | sed 's/^[0-9]*: //' | sort -u | head -60 || true
echo "summaries: $RES ($(ls -1 "$RES" 2>/dev/null | wc -l) files); raw dir: $OUT"
echo "=== end $(date '+%F %T'), $(( $(date +%s) - T_JOB0 ))s, failures=$FAILS ==="
echo "OPT_R1C_DONE failures=$FAILS"

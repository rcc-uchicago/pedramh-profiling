# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# --- Environments ---
venv/
.venv/
env/

# --- Large data / weights (never commit) ---
*.h5
*.nc
*.pt
*.ckpt
*.npy
*.npz
*.tar.gz
# Exception: the small land/soil/topography boundary constants the port needs.
!s2s-lightning/data/constant_mask/*.npy
# Exception: ACE2's HEALPix reorder tables (7.5 MB) — upstream-tracked, and the
# vendored fme.core.hpx module is non-functional without them.
!ACE2_retrain/ace_exp/fme/core/hpx/data/*.npy

# --- Profiling artifacts (large binary captures) ---
*.nsys-rep
*.sqlite
*.qdrep
*.qdstrm

# --- Run outputs / logs ---
*.out
*.err
wandb/
logs/
results/
outs/
gif_out/
acc_plots/
spectra_out/
# Core dumps only. NOT bare `core*` — that also matches a `core/` source
# directory at any depth, which silently swallowed ACE2's 293-file fme/core/.
/core
core.[0-9]*

# --- Editor / OS ---
.idea/
.vscode/
.DS_Store

# editor swap/temp files
*.swp
*.swo
.*.swp
.*.swo
*~

# --- Polaris (PBS) bring-up artifacts ---
polaris_logs/
!polaris_logs/.gitkeep
*.o[0-9]*
*.e[0-9]*
nsys_*.nsys-rep
nsys_*.sqlite

# Polaris SI bench: one CSV per job id (numbers live in polaris_pbs_notes.md)
si/bench_polaris_results_*.csv

# editor/tooling backups -- a timestamped copy of a tracked file is never wanted
*.bak
*.bak.*
